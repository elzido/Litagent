sTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-10-23","dateOfCreation":"2026-10-23","dateOfRevision":"2026-10-26","electronicPublicationDate":"2026-10-23","firstPublicationDate":"2026-10-23","firstIndexDate":"2026-10-25","fullTextReceivedDate":"2026-10-26","hasEvaluations":"N"},{"id":"43011834","source":"MED","pmid":"43011834","pmcid":"PMC13750062","fullTextIdList":{"fullTextId":["PMC13750062"]},"doi":"10.5414/alx400683","title":"Bitter taste receptors are involved in asthma relieved by aspirin: A hypothesis.","authorString":"Picado C, Perpiñá M.","authorList":{"author":[{"fullName":"Picado C","lastName":"Picado","firstName":"César","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Hospital Clinic, School of Medicine and Health Sciences, University of Barcelona, Barcelona."},{"affiliation":"Centro de Investigationes Biomédicas en Red de Enfermedades Respiratorias (CIBERES), Madrid, and."}]}},{"fullName":"Perpiñá M","lastName":"Perpiñá","firstName":"Miguel","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Respiratory Department, Hospital Universitario La Fé, Valéncia, Spain."}]}}]},"journalInfo":{"volume":"10","journalIssueId":4141712,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Allergol Select","title":"Allergologie select","essn":"2512-8957","issn":"2512-8957","nlmid":"101722686","isoabbreviation":"Allergol Select"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"355-365","abstractText":"Nonsteroidal anti-inflammatory drugs (NSAIDs) typically do not affect asthma symptoms in most people. However, there are unique subgroups of patients whose responses to NSAIDs diverge considerably from the norm. Among these individuals, some experience an exacerbation of their asthma - commonly identified as aspirin- or NSAID-exacerbated respiratory disease (AERD and N-ERD, respectively). In contrast, others exhibit a remarkable improvement in their asthma symptoms following the administration of NSAIDs. This improvement is characterized by rapid, pronounced, and long-lasting bronchodilation, resulting in a substantial improvement in clinical symptoms and enhanced respiratory function. The observation of such contrasting responses has prompted further investigation into the mechanisms that might explain this phenomenon. Our hypothesis centers on the activation of bitter taste receptors by NSAIDs, resulting in rapid, significant, and sustained bronchodilation. Notably, this bronchodilator effect closely mirrors the relief observed in those asthma cases that improve with NSAID use. This mechanism provides a potential biological basis for their distinct response to NSAID therapy.","affiliation":"Hospital Clinic, School of Medicine and Health Sciences, University of Barcelona, Barcelona.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["other","Journal Article"]},"keywordList":{"keyword":["Asthma","Cyclooxygenase","NSAIDs","aspirin","Bitter Taste Receptor","Taste Type 2 Receptors"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.5414/ALX400683"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13750062"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13750062?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-11-11","dateOfCreation":"2026-11-11","dateOfRevision":"2026-11-12","electronicPublicationDate":"2026-10-30","firstPublicationDate":"2026-10-30","firstIndexDate":"2026-11-12","fullTextReceivedDate":"2026-11-11","hasEvaluations":"N"},{"id":"42961062","source":"MED","pmid":"42961062","doi":"10.1128/spectrum.02334-26","title":"Changes in respiratory and gut microbiota in asthma and depression associate with disease markers.","authorString":"Lehr K, Stegemann-Koniszewski S, Scharlach M, Thon C, Lücke E, Link A, Schreiber J.","authorList":{"author":[{"fullName":"Lehr K","lastName":"Lehr","firstName":"Konrad","initials":"K","authorId":{"type":"ORCID","value":"0000-0003-3213-8138"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Molecular Gastroenterology and Microbiome Research Unit, Institute for University Teaching and Research Medical Campus Upper Franconia, Friedrich-Alexander University Erlangen-Nürnberg, Bayreuth, Germany."},{"affiliation":"Department of Gastroenterology, Hepatology and Infectious Diseases, Medical Faculty, Otto-von-Guericke University, Magdeburg, Germany."}]}},{"fullName":"Stegemann-Koniszewski S","lastName":"Stegemann-Koniszewski","firstName":"Sabine","initials":"S","authorId":{"type":"ORCID","value":"0000-0002-7931-5077"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pneumology, Medical Faculty, Otto-von-Guericke University, Magdeburg, Germany."}]}},{"fullName":"Scharlach M","lastName":"Scharlach","firstName":"Marie","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pneumology, Medical Faculty, Otto-von-Guericke University, Magdeburg, Germany."}]}},{"fullName":"Thon C","lastName":"Thon","firstName":"Cosima","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastroenterology, Hepatology and Infectious Diseases, Medical Faculty, Otto-von-Guericke University, Magdeburg, Germany."}]}},{"fullName":"Lücke E","lastName":"Lücke","firstName":"Eva","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pneumology, Medical Faculty, Otto-von-Guericke University, Magdeburg, Germany."}]}},{"fullName":"Link A","lastName":"Link","firstName":"Alexander","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Molecular Gastroenterology and Microbiome Research Unit, Institute for University Teaching and Research Medical Campus Upper Franconia, Friedrich-Alexander University Erlangen-Nürnberg, Bayreuth, Germany."},{"affiliation":"Department of Gastroenterology, Hepatology and Infectious Diseases, Medical Faculty, Otto-von-Guericke University, Magdeburg, Germany."},{"affiliation":"Department of Gastroenterology, Friedrich-Alexander University Erlangen-Nürnberg, Medical Campus Upper Franconia, Klinikum Bayreuth, Bayreuth, Germany."}]}},{"fullName":"Schreiber J","lastName":"Schreiber","firstName":"Jens","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pneumology, Medical Faculty, Otto-von-Guericke University, Magdeburg, Germany."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-7931-5077"},{"type":"ORCID","value":"0000-0003-3213-8138"}]},"journalInfo":{"journalIssueId":4275549,"dateOfPublication":"2026 Oct","monthOfPublication":10,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Microbiol Spectr","title":"Microbiology spectrum","essn":"2165-0497","issn":"2165-0497","nlmid":"101634614","isoabbreviation":"Microbiol Spectr"},"printPublicationDate":"2026-10-01"},"pubYear":"2026","pageInfo":"e0233426","abstractText":"Asthma is heterogeneous and frequently accompanied by depression, affecting disease mechanisms and management. Both asthma and depression have been associated with inflammation and microbiota alterations, but their combined impact on microbial compositions remains unclear. Our exploratory study analyzed lung and gut microbiota in patients with asthma and depression to identify associations between microbiota composition and disease markers. This cross-sectional study included 20 healthy controls, 20 patients with asthma, and 20 patients with asthma and comorbid depression. Participants underwent clinical characterization and assessment of asthma control, depression, anxiety, and perceived stress. Induced sputum and fecal samples were collected for microbiota analysis, and inflammatory cytokines were measured in serum and sputum. Microbial profiling was performed using 16S rRNA gene sequencing. Lung function and FeNO levels were comparable between all groups. Asthma control scores were lower, and psychological scores were significantly higher in patients with asthma and comorbid depression compared with asthma alone and controls. Despite similar alpha and beta diversity across groups, sputum and fecal microbiota, particularly of healthy controls and comorbid patients, significantly differed in genus-level taxonomic composition. Correlation analyses demonstrated associations between clinical and psychological parameters and microbial profiles, including a consistent negative correlation between psychological scores and <i>Neisseria</i> abundance in both sputum and fecal samples. Asthma with comorbid depression is associated with distinct alterations in respiratory and gut microbiota, including reduced <i>Neisseria perflava</i> abundance correlating with psychological symptom severity.IMPORTANCEAsthma and depression frequently coexist, yet the potential contribution of microbial alterations to this comorbidity remains poorly understood. Because both respiratory and gut microbiota have been implicated in immune regulation and disease pathophysiology, characterizing microbiota patterns associated with asthma and depression may provide new insights into the biological links between these conditions. In this exploratory study, we investigated respiratory and gut microbiota in individuals with asthma, with and without comorbid depression, and healthy controls. Genus-level community composition differed between groups, particularly between controls and patients with asthma and depression. Notably, reduced abundance of <i>Neisseria perflava</i> in sputum and fecal samples was consistently associated with greater psychological symptom severity. These findings suggest that asthma accompanied by depression is associated with distinct alterations in microbial communities at multiple body sites. Further studies are warranted to determine whether such microbiota-psychological associations contribute to disease mechanisms or may serve as biomarkers of asthma-depression comorbidity.","affiliation":"Molecular Gastroenterology and Microbiome Research Unit, Institute for University Teaching and Research Medical Campus Upper Franconia, Friedrich-Alexander University Erlangen-Nürnberg, Bayreuth, Germany.","publicationStatus":"aheadofprint","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Journal Article"]},"grantsList":{"grant":[{"agency":"Germany Federal Ministry of Education and Research","grantId":"01GM2204A","orderIn":0}]},"keywordList":{"keyword":["Depression","Asthma","Neisseria","Microbiome"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1128/spectrum.02334-26"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCreation":"2026-10-30","dateOfRevision":"2026-10-30","electronicPublicationDate":"2026-10-30","firstPublicationDate":"2026-10-30","firstIndexDate":"2026-10-31","hasEvaluations":"N"},{"id":"42854836","source":"MED","pmid":"42854836","doi":"10.1016/j.jaip.2026.09.034","title":"Benefits and Harms of Dose Escalation of Inhaled Corticosteroids in Uncontrolled Asthma.","authorString":"Bourdin A, Beasley R, Peters AT, Castro M, Lugogo NL, Ledanois O, Martin A, Deniz Y, Iammatteo M, Soliman M, Busse WW.","authorList":{"author":[{"fullName":"Bourdin A","lastName":"Bourdin","firstName":"Arnaud","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Respiratory Diseases, PhyMedExp, University of Montpellier, INSERM CNRS, Montpellier, France. Electronic address: arnaud01009157@gmail.com."}]}},{"fullName":"Beasley R","lastName":"Beasley","firstName":"Richard","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Medical Research Institute of New Zealand, Wellington, New Zealand; Capital, Coast and Hutt Valley District Health Board, Wellington, New Zealand; School of Biological Sciences, Victoria University Wellington, Wellington, New Zealand."}]}},{"fullName":"Peters AT","lastName":"Peters","firstName":"Anju T","initials":"AT","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Allergy-Immunology Division and the Sinus and Allergy Center, Northwestern University Feinberg School of Medicine, Chicago, Ill."}]}},{"fullName":"Castro M","lastName":"Castro","firstName":"Mario","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, University of Kansas School of Medicine, Kansas City, Kan."}]}},{"fullName":"Lugogo NL","lastName":"Lugogo","firstName":"Njira L","initials":"NL","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, Division of Pulmonary and Critical Care Medicine, University of Michigan, Ann Arbor, Mich."}]}},{"fullName":"Ledanois O","lastName":"Ledanois","firstName":"Olivier","initials":"O","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Sanofi, Paris, France."}]}},{"fullName":"Martin A","lastName":"Martin","firstName":"Antonio","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Sanofi, Vernier, Switzerland."}]}},{"fullName":"Deniz Y","lastName":"Deniz","firstName":"Yamo","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Regeneron Pharmaceuticals Inc, Tarrytown, NY."}]}},{"fullName":"Iammatteo M","lastName":"Iammatteo","firstName":"Melissa","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Regeneron Pharmaceuticals Inc, Tarrytown, NY."}]}},{"fullName":"Soliman M","lastName":"Soliman","firstName":"Mena","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Regeneron Pharmaceuticals Inc, Tarrytown, NY."}]}},{"fullName":"Busse WW","lastName":"Busse","firstName":"William W","initials":"WW","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UW Allergy, Pulmonary and Critical Care Medicine, University of Wisconsin School of Medicine and Public Health, Madison, Wis."}]}}]},"journalInfo":{"journalIssueId":4276179,"dateOfPublication":"2026 Oct","monthOfPublication":10,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"J Allergy Clin Immunol Pract","title":"The journal of allergy and clinical immunology. In practice","essn":"2213-2201","issn":"2213-2198","nlmid":"101597220","isoabbreviation":"J Allergy Clin Immunol Pract"},"printPublicationDate":"2026-10-01"},"pubYear":"2026","pageInfo":"S2213-2198(26)00845-7","abstractText":"Treatment with inhaled corticosteroids (ICS) is the cornerstone of asthma management. Although ICS-containing medications effectively reduce exacerbations, improve lung function, and relieve asthma symptoms in most patients with asthma, long-term high-dose ICS have been associated with systemic side effects. In view of these risks, current Global Initiative for Asthma treatment guidance recommends a trial of ICS dose escalation for patients with asthma whose symptoms are poorly controlled on medium-dose ICS. In this review, we discuss the role of ICS in the management of asthma, summarize the clinical evidence for stepping patients from medium- to high-dose ICS, and highlight the risks associated with long-term exposure to high-dose ICS. We further discuss the aspects of personalized asthma treatment related to ICS dose escalation, including biomarker-driven treatment approaches and alternative strategies to improve asthma control that minimize exposure to high-dose ICS. The purpose of this narrative review is to educate physicians on the benefits and risks of ICS while balancing personalized asthma control with minimized high-dose ICS exposure.","affiliation":"Department of Respiratory Diseases, PhyMedExp, University of Montpellier, INSERM CNRS, Montpellier, France. Electronic address: arnaud01009157@gmail.com.","publicationStatus":"aheadofprint","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Journal Article"]},"keywordList":{"keyword":["Asthma","Side effects","Inhaled Corticosteroids","Biologics","Omalizumab","Benralizumab","Dupilumab"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.jaip.2026.09.034"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"N","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCreation":"2026-10-09","dateOfRevision":"2026-11-01","electronicPublicationDate":"2026-10-09","firstPublicationDate":"2026-10-09","firstIndexDate":"2026-10-17","hasEvaluations":"N"},{"id":"42651395","source":"MED","pmid":"42651395","pmcid":"PMC13512896","fullTextIdList":{"fullTextId":["PMC13512896"]},"doi":"10.3390/healthcare14162626","title":"Factors Associated with Domain-Specific Asthma-Related Quality of Life in Adults with Asthma.","authorString":"Poplicean EI, Crișan AF, Tudorache E, Huidu BM, Jipa DA, Mladin R, Epuraș IC, Gib C, Oancea C.","authorList":{"author":[{"fullName":"Poplicean EI","lastName":"Poplicean","firstName":"Emanuel Ionuț","initials":"EI","authorId":{"type":"ORCID","value":"0009-0006-7489-4811"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Doctoral School, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."},{"affiliation":"Center of Research and Innovation in Personalized Medicine of Respiratory Disease (CRIPMRD), \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."}]}},{"fullName":"Crișan AF","lastName":"Crișan","firstName":"Alexandru Florian","initials":"AF","authorId":{"type":"ORCID","value":"0009-0002-6020-4593"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pulmonary Rehabilitation Center, Clinical Hospital of Infectious Diseases and Pulmonology, \"Victor Babes\", Gheorghe Adam Street 13, 300310 Timisoara, Romania."},{"affiliation":"Research Center for the Assessment of Human Motion, Functionality and Disability (CEMFD), \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."}]}},{"fullName":"Tudorache E","lastName":"Tudorache","firstName":"Emanuela","initials":"E","authorId":{"type":"ORCID","value":"0000-0001-6667-3185"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center of Research and Innovation in Personalized Medicine of Respiratory Disease (CRIPMRD), \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."},{"affiliation":"Pulmonology University Clinic, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."}]}},{"fullName":"Huidu BM","lastName":"Huidu","firstName":"Bianca Mădălina","initials":"BM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Doctoral School, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."},{"affiliation":"Centre for Translational Research and Systems Medicine, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."}]}},{"fullName":"Jipa DA","lastName":"Jipa","firstName":"Daniel Alexandru","initials":"DA","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Doctoral School, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."},{"affiliation":"Center of Research and Innovation in Personalized Medicine of Respiratory Disease (CRIPMRD), \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."}]}},{"fullName":"Mladin R","lastName":"Mladin","firstName":"Roxana","initials":"R","authorId":{"type":"ORCID","value":"0009-0001-6237-939X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Doctoral School, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."},{"affiliation":"Center of Research and Innovation in Personalized Medicine of Respiratory Disease (CRIPMRD), \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."}]}},{"fullName":"Epuraș IC","lastName":"Epuraș","firstName":"Ion Costel","initials":"IC","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Doctoral School, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."},{"affiliation":"Oftalmo Sensory-Tumor Research Center-ORL (EYE-ENT), \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."}]}},{"fullName":"Gib C","lastName":"Gib","firstName":"Carina","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Doctoral School, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."},{"affiliation":"Center of Advanced Research in Cardiology and Hemostasology, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."}]}},{"fullName":"Oancea C","lastName":"Oancea","firstName":"Cristian","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center of Research and Innovation in Personalized Medicine of Respiratory Disease (CRIPMRD), \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."},{"affiliation":"Pulmonology University Clinic, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-6667-3185"},{"type":"ORCID","value":"0009-0001-6237-939X"},{"type":"ORCID","value":"0009-0002-6020-4593"},{"type":"ORCID","value":"0009-0006-7489-4811"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"16","volume":"14","journalIssueId":4250082,"dateOfPublication":"2026 Aug","monthOfPublication":8,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Healthcare (Basel)","title":"Healthcare (Basel, Switzerland)","essn":"2227-9032","issn":"2227-9032","nlmid":"101666525","isoabbreviation":"Healthcare (Basel)"},"printPublicationDate":"2026-08-01"},"pubYear":"2026","pageInfo":"2626","abstractText":"<b>Background/Objective</b>: Asthma-related quality of life is related to multiple clinical, physiological, and behavioral factors. Nonetheless, the domain-specific associations of asthma control, inhaler adherence, lung function, and demographic characteristics remain poorly understood. This study aimed to examine the adjusted associations of asthma control, inhaler adherence, lung function, and age with individual domains of asthma-related quality of life. <b>Methods</b>: This cross-sectional observational study included 92 adults with asthma who demonstrated correct inhaler technique and adequate knowledge of their prescribed inhaler regimen. Asthma control was measured using the Asthma Control Test (ACT), inhaler adherence using the Test of Adherence to Inhalers (TAI), and quality of life using the Asthma Quality of Life Questionnaire (AQLQ). Pulmonary function was determined through spirometry. Spearman correlation analyses were initially conducted to identify associations between variables. Subsequently, separate multivariable linear regression models were created for each AQLQ domain, including ACT score, TAI score, age, and FEV<sub>1</sub> % predicted as predictors. <b>Results</b>: A total of 92 adult patients with asthma were studied. Asthma control was significantly positively correlated with all AQLQ domains (all <i>p</i> < 0.001). In multivariable analyses, ACT had the largest absolute standardized coefficient within each of the four domain-specific models (standardized β range: 0.339-0.791). After adjustment, age was associated with the activity limitation and symptom domains, whereas FEV<sub>1</sub> % predicted was associated only with the environmental stimuli domain. Inhaler adherence showed an inverse association with emotional functioning in the fully adjusted model (B = -0.094, 95% CI -0.158--0.031; <i>p</i> = 0.0038). However, this association was absent in the bivariate analysis and in a sensitivity model excluding ACT (B = -0.015, 95% CI -0.067-0.037; <i>p</i> = 0.562), suggesting a possible suppression effect. <b>Conclusions</b>: ACT showed the largest standardized association within each domain-specific model, although the magnitude of its associations with the symptom and activity-limitation domains may partly reflect conceptual overlap between the instruments. The inverse TAI-emotional-functioning coefficient was model-dependent, did not meet the conservative multiplicity benchmark, and should be considered exploratory and hypothesis-generating. Additionally, lung function and age showed domain-specific associations, highlighting the need for a comprehensive, multidimensional approach in asthma management.","affiliation":"Doctoral School, \"Victor Babes\" University of Medicine and Pharmacy Timisoara, Eftimie Murgu Square 2, 300041 Timisoara, Romania.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Quality of life","Treatment Adherence","Asthma Control","Aqlq"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/healthcare14162626"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13512896"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13512896?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-08-27","dateOfCreation":"2026-08-27","dateOfRevision":"2026-08-29","electronicPublicationDate":"2026-08-19","firstPublicationDate":"2026-08-19","firstIndexDate":"2026-08-30","fullTextReceivedDate":"2026-09-10","hasEvaluations":"N"},{"id":"42835283","source":"MED","pmid":"42835283","doi":"10.7759/cureus.115818","title":"A Cross-Sectional Observational Study of the Correlation Between Asthma-Related Quality of Life (AQLQ) and Asthma Control Measures.","authorString":"Anantharaj S, Sathish A, N S.","authorList":{"author":[{"fullName":"Anantharaj S","lastName":"Anantharaj","firstName":"Suresh","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Respiratory Medicine, Sree Balaji Medical College and Hospital, Chennai, IND."}]}},{"fullName":"Sathish A","lastName":"Sathish","firstName":"Ashwini","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Family Medicine, Sundaram Medical Foundation, Chennai, IND."}]}},{"fullName":"N S","lastName":"N","firstName":"Suganya","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Epidemiology and Public Health, Sundaram Medical Foundation, Chennai, IND."}]}}]},"journalInfo":{"issue":"9","volume":"18","journalIssueId":4253180,"dateOfPublication":"2026 Sep","monthOfPublication":9,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Cureus","title":"Cureus","essn":"2168-8184","issn":"2168-8184","nlmid":"101596737","isoabbreviation":"Cureus"},"printPublicationDate":"2026-09-01"},"pubYear":"2026","pageInfo":"e115818","abstractText":"Introduction The Asthma Control Questionnaire (ACQ) and Asthma Control Test (ACT) are widely used to assess asthma control but are more time-consuming than the Global Initiative for Asthma (GINA) level of control (LoC), a simpler tool that is commonly used in busy clinical settings. Despite the substantial impact of asthma on quality of life, quality-of-life assessment is performed less frequently than assessment of asthma control. This study aimed to evaluate the correlation between the Asthma Quality of Life Questionnaire (AQLQ) and measures of asthma control, including the ACQ and GINA LoC. The primary objective was to compare the strength of the correlations of the ACQ and GINA LoC with the AQLQ. Methods Patients with partly controlled or uncontrolled asthma, as defined by the GINA LoC, were recruited after confirmation of the diagnosis by spirometry (post-bronchodilator increase in FEV₁ and/or FVC of >200 mL and >12%) or peak expiratory flow rate (PEFR) criteria (post-bronchodilator improvement in PEFR ≥20%). Baseline demographic and clinical characteristics, including symptoms, smoking status, treatment, and comorbidities, were recorded. All participants completed the AQLQ and ACQ. Correlations of the AQLQ with the ACQ, GINA LoC, and pulmonary function parameters were analyzed. Pearson's correlation coefficient was used to assess the relationships between the AQLQ, pulmonary function parameters (FEV₁ and PEFR), and asthma control measures (ACQ and GINA LoC). Categorical variables, including age distribution and sex, were analyzed using the chi-square test. Results Among the 83 patients with asthma, 32 (38.6%) had partly controlled asthma, while 51 (61.4%) had uncontrolled asthma. The mean age and body mass index (BMI) were 43 ± 14.5 years and 28.3 ± 3.9 kg/m², respectively. The proportions of females, patients with more than two symptoms, a positive family history of asthma, allergic rhinitis, and gastroesophageal reflux disease were 47 (56.6%), 17 (20.5%), 28 (33.7%), 17 (20.5%), and nine (10.8%), respectively. The mean ACQ score, AQLQ score, pre-bronchodilator FEV₁ (% predicted), and PEFR (% predicted) were 2.08, 4.4, 58.6%, and 71%, respectively. The ACQ demonstrated a strong negative correlation with the AQLQ (r = -0.60, p < 0.001), whereas the GINA LoC showed a weak negative correlation with the AQLQ (r = -0.28, p = 0.01). A weak positive correlation was observed between the ACQ and GINA LoC (r = 0.38, p < 0.001). Among pulmonary functions, FEV₁ showed a weak positive correlation with the AQLQ (r = 0.22, p = 0.046) and a weak negative correlation with the GINA LoC (r = -0.24, p = 0.029). PEFR demonstrated a moderate negative correlation with the GINA LoC (r = -0.40, p < 0.001). Conclusion Although the ACQ is more time-consuming than the GINA LoC, it demonstrated a stronger correlation with asthma-specific quality of life and may be a better predictor of quality of life in adults with asthma.","affiliation":"Respiratory Medicine, Sree Balaji Medical College and Hospital, Chennai, IND.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Journal Article"]},"keywordList":{"keyword":["Quality of life","pulmonary function","Asthma Control","Asthma Symptoms","Acq","Aqlq","Gina Asthma Control"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.7759/cureus.115818"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-10-06","dateOfCreation":"2026-10-06","dateOfRevision":"2026-10-07","electronicPublicationDate":"2026-09-05","firstPublicationDate":"2026-09-05","firstIndexDate":"2026-10-16","hasEvaluations":"N"},{"id":"42851795","source":"MED","pmid":"42851795","doi":"10.5414/alx02646e","title":"Dupilumab improves long-term asthma control in German patients with severe asthma: Real-world data.","authorString":"Renner A, Stoshikj S, Hamelmann E, Skowasch D, Schulz C, Jandl M, Schmidt O, Milger K, Ehmann R, Taube C, Korn S, Buhl R, Idzko M, German Asthma Net (GAN) study group.","authorList":{"author":[{"fullName":"Renner A","lastName":"Renner","firstName":"Andreas","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pneumology, Medical University of Vienna, Vienna, Austria."},{"affiliation":"Comprehensive Center for Chest Diseases, Medical University of Vienna, Vienna, Austria."}]}},{"fullName":"Stoshikj S","lastName":"Stoshikj","firstName":"Slagjana","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pneumology, Medical University of Vienna, Vienna, Austria."},{"affiliation":"Comprehensive Center for Chest Diseases, Medical University of Vienna, Vienna, Austria."}]}},{"fullName":"Hamelmann E","lastName":"Hamelmann","firstName":"Eckard","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Kinderzentrum Bethel, Evangelisches Klinikum Bethel, University Bielefeld, Bielefeld."}]}},{"fullName":"Skowasch D","lastName":"Skowasch","firstName":"Dirk","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Internal Medicine II - Pneumology, University Hospital Bonn, Bonn."}]}},{"fullName":"Schulz C","lastName":"Schulz","firstName":"Christian","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Internal Medicine II, University Hospital Regensburg, Regensburg."}]}},{"fullName":"Jandl M","lastName":"Jandl","firstName":"Margret","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Hamburger Institut für Therapieforschung GmbH, Hamburg."}]}},{"fullName":"Schmidt O","lastName":"Schmidt","firstName":"Olaf","initials":"O","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pneumologische Gemeinschaftspraxis und Studienzentrum KPPK, Koblenz, Germany."}]}},{"fullName":"Milger K","lastName":"Milger","firstName":"Katrin","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Respiratory Medicine, Lung Research Cluster, Department of Internal Medicine, Medical University of Graz, Graz, Austria."},{"affiliation":"Department of Medicine V, Ludwig-Maximilians-University (LMU) of Munich, Comprehensive Pneumology Center (CPC-M) German Center for Lung Research (DZL), Munich."}]}},{"fullName":"Ehmann R","lastName":"Ehmann","firstName":"Rainer","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Ambulante Pneumologie mit Allergiezentrum, Stuttgart."}]}},{"fullName":"Taube C","lastName":"Taube","firstName":"Christian","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pulmonary Medicine, University Hospital Essen - Ruhrlandklinik, Essen."}]}},{"fullName":"Korn S","lastName":"Korn","firstName":"Stephanie","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pulmonary and Respiratory Critical Care Medicine, Thoraxklinik Heidelberg und IKF Pneumologie Mainz, and."}]}},{"fullName":"Buhl R","lastName":"Buhl","firstName":"Roland","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pulmonary Department, Mainz University Hospital, Mainz, Germany."},{"affiliation":"Contributed equally."}]}},{"fullName":"Idzko M","lastName":"Idzko","firstName":"Marco","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pneumology, Medical University of Vienna, Vienna, Austria."},{"affiliation":"Comprehensive Center for Chest Diseases, Medical University of Vienna, Vienna, Austria."},{"affiliation":"Contributed equally."}]}},{"collectiveName":"German Asthma Net (GAN) study group"}]},"journalInfo":{"volume":"10","journalIssueId":4141712,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Allergol Select","title":"Allergologie select","essn":"2512-8957","issn":"2512-8957","nlmid":"101722686","isoabbreviation":"Allergol Select"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"268-279","abstractText":"<h4>Background</h4>Dupilumab has proven effective in severe asthma, but there is only sparse evidence on its impact on asthma control in a real-world setting.<h4>Materials and methods</h4>All patients from the German Asthma Net (GAN) severe asthma registry who initiated dupilumab after inclusion into the registry were analyzed. Clinical effectiveness was evaluated in those with at least 2 follow-up visits, with a maximum follow-up time of 3 years.<h4>Results</h4>A total of 481 patients with severe asthma initiated dupilumab. At baseline, median blood eosinophil count was 174 cells/µL (IQR 61.2 - 436); 184 (38.3%) were former smokers with median 9.6 pack-years (IQR 4.3 - 23.3). Clinical effectiveness was evaluated in 235 patients. The FEV<sub>1</sub> increase from baseline was maintained over the whole study period (+300 mL at 4 months and 1 year, +200 mL at 2 and 3 years, all p < 0.0001). The frequency of exacerbations decreased, and the Asthma Control Test score increased from baseline clinically significantly at all timepoints (+4.3 at 4 months, +4.9 points at 1 year, +5.3 points at 2 years, and +4.6 points at 3 years, all p < 0.0001). Dupilumab was well tolerated; < 10% of patients reported adverse events or discontinued dupilumab treatment. The only adverse events recorded in more than 1 patient were conjunctivitis (4 patients), joint pain (3 patients), and flu-like symptoms (2 patients).<h4>Conclusion</h4>In this large real-life study of dupilumab in patients with severe asthma dupilumab showed long-term clinical effectiveness for up to 3 years, with results consistent with prior randomized controlled trials.","affiliation":"Department of Pneumology, Medical University of Vienna, Vienna, Austria.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Journal Article"]},"keywordList":{"keyword":["Airway inflammation","Severe asthma","Biologics","Real-life Data","Monoclonal Antibody Treatment"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.5414/ALX02646E"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-10-09","dateOfCreation":"2026-10-09","dateOfRevision":"2026-10-10","electronicPublicationDate":"2026-09-25","firstPublicationDate":"2026-09-25","firstIndexDate":"2026-10-16","hasEvaluations":"N"},{"id":"42899550","source":"MED","pmid":"42899550","doi":"10.1080/02770903.2026.2751846","title":"Usability, educational engagement, and patient-reported outcomes in a mobile asthma intervention.","authorString":"Zhang S, Li X, Choi DH, Desai S, Patel R, Agarwal R, Ahsan AM, Green S, Feldman JM, Reznik M, Su Z, Zheng K, Jariwala SP.","authorList":{"author":[{"fullName":"Zhang S","lastName":"Zhang","firstName":"Serena","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."}]}},{"fullName":"Li X","lastName":"Li","firstName":"Xinqing","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."}]}},{"fullName":"Choi DH","lastName":"Choi","firstName":"Da Hae","initials":"DH","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."}]}},{"fullName":"Desai S","lastName":"Desai","firstName":"Sheil","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."}]}},{"fullName":"Patel R","lastName":"Patel","firstName":"Ronit","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."}]}},{"fullName":"Agarwal R","lastName":"Agarwal","firstName":"Rishab","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."}]}},{"fullName":"Ahsan AM","lastName":"Ahsan","firstName":"Atiq M","initials":"AM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."}]}},{"fullName":"Green S","lastName":"Green","firstName":"Samuel","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Allergy/Immunology, Montefiore Medical Center, Bronx, NY, USA."}]}},{"fullName":"Feldman JM","lastName":"Feldman","firstName":"Jonathan M","initials":"JM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."},{"affiliation":"Department of Pediatrics, Children's Hospital at Montefiore Einstein, Bronx, NY, USA."},{"affiliation":"Ferkauf Graduate School of Psychology, Yeshiva University, Bronx, NY, USA."}]}},{"fullName":"Reznik M","lastName":"Reznik","firstName":"Marina","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."},{"affiliation":"Department of Pediatrics, Children's Hospital at Montefiore Einstein, Bronx, NY, USA."}]}},{"fullName":"Su Z","lastName":"Su","firstName":"Zhaoyuan","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Informatics, University of California, Irvine, CA, USA."}]}},{"fullName":"Zheng K","lastName":"Zheng","firstName":"Kai","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Informatics, University of California, Irvine, CA, USA."}]}},{"fullName":"Jariwala SP","lastName":"Jariwala","firstName":"Sunit P","initials":"SP","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA."},{"affiliation":"Department of Allergy/Immunology, Montefiore Medical Center, Bronx, NY, USA."}]}}]},"journalInfo":{"journalIssueId":4304304,"dateOfPublication":"2026 Nov","monthOfPublication":11,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"J Asthma","title":"The Journal of asthma : official journal of the Association for the Care of Asthma","essn":"1532-4303","issn":"0277-0903","nlmid":"8106454","isoabbreviation":"J Asthma"},"printPublicationDate":"2026-11-01"},"pubYear":"2026","pageInfo":"1-10","abstractText":"<h4>Objective</h4>Mobile health tools offer scalable strategies for asthma self-management, but relationships between usability, engagement, and clinical outcomes remain unclear. We evaluated whether usability of ASTHMAXcel PRO, a mobile asthma education and self-management application, promotes educational engagement and whether early engagement predicts asthma outcomes.<h4>Methods</h4>Adults with asthma on daily controller therapy from three Bronx clinics participated in a 12-month study using ASTHMAXcel PRO in addition to usual care. Usability was assessed using the Questionnaire for User Interface Satisfaction (QUIS). Early engagement was measured during the first two months, with high educational engagement defined as the top quartile of chapters completed. Outcomes included asthma control (Asthma Control Test [ACT]), asthma-related quality of life (mini-Asthma Quality of Life Questionnaire [mini-AQLQ]), and composite asthma-related healthcare utilization. Associations were examined using mixed-effects, interaction, logistic, and mediation analyses adjusted for age, gender, and baseline outcome status.<h4>Results</h4>Among 44 participants (mean age 43.75 ± 14.07 years; 84.1% female; 95.5% non-White), higher usability was associated with greater early engagement (OR 2.39 per 1-SD increase, 95% CI 1.28-5.19, <i>p</i> = 0.01). ACT and mini-AQLQ improved over time. However, early engagement was not associated with differential improvements in either outcome. Baseline outcome status was the strongest predictor of longitudinal outcomes, and no mediation effects were observed.<h4>Conclusions</h4>In this urban, high-burden cohort, usability predicted early engagement but not clinical benefit. Baseline outcome status remained the strongest predictor of longitudinal outcomes. These findings suggest that digital asthma interventions may require targeted, content-specific engagement strategies beyond usability alone to improve outcomes.","affiliation":"Albert Einstein College of Medicine, Bronx, NY, USA.","publicationStatus":"aheadofprint","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Journal Article"]},"grantsList":{"grant":[{"agency":"Agency for Healthcare Research and Quality","grantId":"R18 HS025645","orderIn":0}]},"keywordList":{"keyword":["Adherence","Health education","Self-management","User-centered Design","Mobile Health (Mhealth)","Digital Health Interventions"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1080/02770903.2026.2751846"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCreation":"2026-10-20","dateOfRevision":"2026-11-03","electronicPublicationDate":"2026-11-03","firstPublicationDate":"2026-11-03","firstIndexDate":"2026-10-21","hasEvaluations":"N"},{"id":"42921507","source":"MED","pmid":"42921507","pmcid":"PMC13693513","fullTextIdList":{"fullTextId":["PMC13693513"]},"doi":"10.2147/dmso.s614951","title":"Impact of Asthma and Corticosteroid Exposure on Glycemic Markers in Overweight and Obese Children.","authorString":"Noor S, Abdelhamid A, Al-Haneedi Y, Tluli O, Shailesh H, Hamdoun E, Abu-Hasan M, Janahi IA.","authorList":{"author":[{"fullName":"Noor S","lastName":"Noor","firstName":"Safa","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pediatric Medicine, Division of Pulmonology, Sidra Medicine, Doha, Qatar."}]}},{"fullName":"Abdelhamid A","lastName":"Abdelhamid","firstName":"Alaa","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Medicine, Qatar University, Doha, Qatar."}]}},{"fullName":"Al-Haneedi Y","lastName":"Al-Haneedi","firstName":"Yaman","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Medicine, Qatar University, Doha, Qatar."}]}},{"fullName":"Tluli O","lastName":"Tluli","firstName":"Omar","initials":"O","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Medicine, Qatar University, Doha, Qatar."}]}},{"fullName":"Shailesh H","lastName":"Shailesh","firstName":"Harshita","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pediatric Medicine, Division of Pulmonology, Sidra Medicine, Doha, Qatar."}]}},{"fullName":"Hamdoun E","lastName":"Hamdoun","firstName":"Elwaseila","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pediatric Medicine, Division of Endocrinology and Diabetes, Sidra Medicine, Doha, Qatar."}]}},{"fullName":"Abu-Hasan M","lastName":"Abu-Hasan","firstName":"Mutasim","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pediatric Medicine, Division of Pulmonology, Sidra Medicine, Doha, Qatar."}]}},{"fullName":"Janahi IA","lastName":"Janahi","firstName":"Ibrahim A","initials":"IA","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pediatric Medicine, Division of Pulmonology, Sidra Medicine, Doha, Qatar."},{"affiliation":"Department of Pediatrics, Weill Cornell Medicine, Doha, Qatar."}]}}]},"journalInfo":{"volume":"19","journalIssueId":4091800,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Diabetes Metab Syndr Obes","title":"Diabetes, metabolic syndrome and obesity : targets and therapy","essn":"1178-7007","issn":"1178-7007","nlmid":"101515585","isoabbreviation":"Diabetes Metab Syndr Obes"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"614951","abstractText":"<h4>Purpose</h4>Corticosteroids are the cornerstone of asthma management, yet they are associated with hyperglycemia and insulin resistance. This study evaluated associations between asthma characteristics and glycemic markers in children with overweight or obesity and examined whether corticosteroid exposure modifies these associations.<h4>Methods</h4>This cross-sectional study included 199 children aged 6-17 years with overweight or obesity from the Middle East and North Africa region. They were divided into two groups: with asthma (OO-A) (N = 100) and without asthma (OO) (N = 99). Asthma phenotype was classified as type 2 (blood eosinophils ≥ 300 cells/µL, FeNO ≥ 30 ppb, or confirmed allergy) or non-type 2 asthma. Asthma severity was classified based on FEV<sub>1</sub>% predicted: mild (≥ 80%), moderate (60% to < 80%), and severe (< 60%). Linear and logistic regression models assessed associations between asthma characteristics and glycemic markers in the circulation before and after adjusting for corticosteroid use.<h4>Results</h4>Asthma was associated with higher HbA1c (β = 0.152, p = 0.007) and prediabetes (HbA1c ≥ 5.7%) (OR = 2.69, p = 0.026) only when not adjusting for corticosteroid use. Mediation analysis showed that corticosteroid exposure may account for 45.4% of the total effect of asthma on HbA1c (p = 0.024). The OO group had a higher prevalence of insulin resistance (HOMA-IR ≥ 2.5) (p = 0.029). Type 2 asthma was associated with higher HbA1c without corticosteroid adjustment (β = 0.176, p = 0.002), which was attenuated after corticosteroid adjustment (β = 0.116, p = 0.057). Severe asthma remained significantly associated with higher HbA1c in both models regardless of corticosteroid adjustment (β = 0.347-0.409, p < 0.05). No consistent associations were found with other glycemic markers.<h4>Conclusion</h4>The asthma-HbA1c association in children with overweight/obesity may be largely mediated by corticosteroid use. Severe asthma may have a direct association with HbA1c independent of steroid use. Given the cross-sectional design and limited sample sizes, these findings require confirmation in larger longitudinal studies with more precise assessments of corticosteroid exposure and other confounders to clarify causal pathways and to evaluate whether optimizing asthma management while minimizing corticosteroid exposure could reduce long-term metabolic risk in this vulnerable population.","affiliation":"Department of Pediatric Medicine, Division of Pulmonology, Sidra Medicine, Doha, Qatar.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["BMI","Corticosteroids","Pediatrics","Hba1c","Childhood Asthma"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2147/DMSO.S614951"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13693513"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13693513?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-10-24","dateOfCreation":"2026-10-24","dateOfRevision":"2026-10-26","electronicPublicationDate":"2026-10-19","firstPublicationDate":"2026-10-19","firstIndexDate":"2026-10-25","fullTextReceivedDate":"2026-10-24","hasEvaluations":"N"},{"id":"43011614","source":"MED","pmid":"43011614","pmcid":"PMC13750594","fullTextIdList":{"fullTextId":["PMC13750594"]},"doi":"10.1183/23120541.00462-2026","title":"Cardiovascular effects and mortality of short-acting bronchodilators in asthma and COPD.","authorString":"Van Vaerenbergh F, Vauterin D, Bloom C, Lahousse L.","authorList":{"author":[{"fullName":"Van Vaerenbergh F","lastName":"Van Vaerenbergh","firstName":"Frauke","initials":"F","authorId":{"type":"ORCID","value":"0000-0002-7709-7651"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Bioanalysis, Faculty of Pharmaceutical Sciences, Ghent University, Ghent, Belgium."}]}},{"fullName":"Vauterin D","lastName":"Vauterin","firstName":"Delphine","initials":"D","authorId":{"type":"ORCID","value":"0000-0002-8932-476X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Bioanalysis, Faculty of Pharmaceutical Sciences, Ghent University, Ghent, Belgium."}]}},{"fullName":"Bloom C","lastName":"Bloom","firstName":"Chloe","initials":"C","authorId":{"type":"ORCID","value":"0000-0003-1285-7602"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"National Heart and Lung Institute, Imperial College London, London, UK."}]}},{"fullName":"Lahousse L","lastName":"Lahousse","firstName":"Lies","initials":"L","authorId":{"type":"ORCID","value":"0000-0002-3494-4363"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Bioanalysis, Faculty of Pharmaceutical Sciences, Ghent University, Ghent, Belgium."},{"affiliation":"Department of Epidemiology, Erasmus Medical Center, Rotterdam, the Netherlands."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-3494-4363"},{"type":"ORCID","value":"0000-0002-7709-7651"},{"type":"ORCID","value":"0000-0002-8932-476X"},{"type":"ORCID","value":"0000-0003-1285-7602"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"6","volume":"12","journalIssueId":4304355,"dateOfPublication":"2026 Nov","monthOfPublication":11,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"ERJ Open Res","title":"ERJ open research","essn":"2312-0541","issn":"2312-0541","nlmid":"101671641","isoabbreviation":"ERJ Open Res"},"printPublicationDate":"2026-11-01"},"pubYear":"2026","pageInfo":"462-2026","abstractText":"<h4>Background</h4>Prior research has focused on short-acting β<sub>2</sub>-agonist (SABA) overuse-related adverse outcomes in asthma patients. Evidence on the association between use of short-acting bronchodilators in general and cardiovascular events in asthma/COPD populations remains limited.<h4>Methods</h4>Adult patients with chronic treatment of asthma or COPD were identified in a Belgian nationwide cohort between 2017 and 2022. A Cox model adjusted for age, sex, smoking, socioeconomic status, exacerbation history, comorbidities and medication use, was used to investigate the association between SABA, short-acting muscarinic antagonist (SAMA) and SABA+SAMA use with cardiovascular risk and all-cause mortality.<h4>Results</h4>The cohort included 226 314 asthma patients (mean age 57.8 years, 60.5% females) and 57 446 COPD patients (mean age 72.2 years, 38.0% females). Compared with no use, SAMA and SABA+SAMA use (1-2 and ≥3 canisters per baseline year) was associated with increased heart failure (1.2-1.4-fold), arrhythmia (1.1-1.4-fold) and mortality risk (1.1-1.7-fold) in asthma and COPD patients. Among asthma patients, use of 1-2, and ≥3 SABA+SAMA canisters per year were additionally associated with increased myocardial infarction (1.2-1.4-fold) and ischaemic stroke risk (1.2-1.3-fold), and ≥3 SABA+SAMA canisters per year with a 1.4-fold myocardial infarction risk in COPD patients. Compared with no SABA users, ≥3 SABA canisters per year was associated with a 1.1-fold increased heart failure and mortality risk in asthma and COPD patients, while no increased risks were observed for 1-2 SABA canisters.<h4>Conclusion</h4>Increased use of SAMA or SABA+SAMA was associated with increased risks of cardiovascular events and mortality in patients with asthma and COPD. Collecting three or more SABA canisters per year was associated with increased mortality.","affiliation":"Department of Bioanalysis, Faculty of Pharmaceutical Sciences, Ghent University, Ghent, Belgium.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1183/23120541.00462-2026"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13750594"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13750594?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"N","hasData":"Y","license":"cc by-nc","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-11-11","dateOfCreation":"2026-11-11","dateOfRevision":"2026-11-12","electronicPublicationDate":"2026-11-09","firstPublicationDate":"2026-11-09","firstIndexDate":"2026-11-12","fullTextReceivedDate":"2026-11-11","hasEvaluations":"N"},{"id":"43011565","source":"MED","pmid":"43011565","pmcid":"PMC13750559","fullTextIdList":{"fullTextId":["PMC13750559"]},"doi":"10.1183/23120541.00190-2026","title":"Discordant associations between type 2 biomarkers and severity of asthma and COPD.","authorString":"Janson C, Malinovschi A, Borres M, Faner R, Hughes R, Mangelis A, Ma X, Mullerova H, Olaguibel JM, Papi A, Reddel HK.","authorList":{"author":[{"fullName":"Janson C","lastName":"Janson","firstName":"Christer","initials":"C","authorId":{"type":"ORCID","value":"0000-0001-5093-6980"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical Sciences: Respiratory, Allergy and Sleep Research, Uppsala University, Uppsala, Sweden."}]}},{"fullName":"Malinovschi A","lastName":"Malinovschi","firstName":"Andrei","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-4098-7765"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical Sciences: Clinical Physiology, Uppsala University, Uppsala, Sweden."}]}},{"fullName":"Borres M","lastName":"Borres","firstName":"Magnus","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Women's and Children's Health, Uppsala University, Uppsala, Sweden."}]}},{"fullName":"Faner R","lastName":"Faner","firstName":"Rosa","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Biomedicine Department, Universitat de Barcelona, CIBER Enfermedades Respiratorias, IDIBAPS, Barcelona, Spain."}]}},{"fullName":"Hughes R","lastName":"Hughes","firstName":"Rod","initials":"R","authorId":{"type":"ORCID","value":"0009-0006-1200-5580"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"BioPharmaceuticals Medical, AstraZeneca, Cambridge, UK."}]}},{"fullName":"Mangelis A","lastName":"Mangelis","firstName":"Anastasios","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"BioPharmaceuticals Medical, AstraZeneca, Cambridge, UK."},{"affiliation":"Phastar, London, UK."}]}},{"fullName":"Ma X","lastName":"Ma","firstName":"Xiaomeng","initials":"X","authorId":{"type":"ORCID","value":"0000-0002-4165-3062"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Health Policy and Management and Evaluation, University of Toronto, Toronto, ON, Canada."}]}},{"fullName":"Mullerova H","lastName":"Mullerova","firstName":"Hana","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"BioPharmaceuticals Medical, AstraZeneca, Cambridge, UK."}]}},{"fullName":"Olaguibel JM","lastName":"Olaguibel","firstName":"Jose Maria","initials":"JM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Allergy Service, Hospital Universitario de Navarra, Pamplona, Spain."}]}},{"fullName":"Papi A","lastName":"Papi","firstName":"Alberto","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-6924-4500"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Respiratory Medicine Unit, Department of Translational Medicine, Università di Ferrara, Ferrara, Italy."}]}},{"fullName":"Reddel HK","lastName":"Reddel","firstName":"Helen K","initials":"HK","authorId":{"type":"ORCID","value":"0000-0002-6695-6350"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Woolcock Institute of Medical Research and Macquarie Medical School, Macquarie University, Sydney, Australia."},{"affiliation":"Sydney Local Health District, Sydney, Australia."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5093-6980"},{"type":"ORCID","value":"0000-0002-4098-7765"},{"type":"ORCID","value":"0000-0002-4165-3062"},{"type":"ORCID","value":"0000-0002-6695-6350"},{"type":"ORCID","value":"0000-0002-6924-4500"},{"type":"ORCID","value":"0009-0006-1200-5580"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"6","volume":"12","journalIssueId":4304355,"dateOfPublication":"2026 Nov","monthOfPublication":11,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"ERJ Open Res","title":"ERJ open research","essn":"2312-0541","issn":"2312-0541","nlmid":"101671641","isoabbreviation":"ERJ Open Res"},"printPublicationDate":"2026-11-01"},"pubYear":"2026","pageInfo":"190-2026","abstractText":"<h4>Background</h4>Allergic and type 2 (T2) inflammatory biomarkers are increasingly used to predict outcomes and guide treatment in asthma and COPD. The objective of this cross-sectional study was to determine the prevalence of allergic sensitisation and T2 biomarkers and their clinical associations among patients with diagnoses of asthma and/or COPD in NOVELTY, a large multinational, observational study.<h4>Methods</h4>Participants were enrolled from primary/specialist care, stratified by physician-assigned diagnosis and severity. We assessed fractional exhaled nitric oxide (≥25 ppb), blood eosinophils (≥300 cells·µL<sup>-1</sup>) and allergen-specific IgE sensitisation (≥0.35 kU·L<sup>-1</sup> to any of 11 aeroallergens). Associations between biomarkers and clinical outcomes were examined using descriptive statistics and multivariable regression models adjusted for age, sex, body mass index and smoking status.<h4>Results</h4>Data for all biomarkers were available for 4352 participants (asthma: n=2194; asthma+COPD: n=633; COPD: n=1525). Overall, 63% participants had at least one positive biomarker (asthma: 77%; asthma+COPD: 60%; COPD: 45%); only 8%, 4% and 1% of participants, respectively, were positive for all three biomarkers. Women and current smokers were more likely to be triple-negative. Among participants with asthma, having more positive biomarkers was associated with more severe physician-assessed disease, lower lung function and exacerbations. By contrast, in COPD, having no positive biomarkers was associated with more severe physician-assessed disease and lower lung function.<h4>Conclusions</h4>Allergic and T2 biomarkers are highly prevalent in asthma and asthma+COPD but less frequent in COPD. Their patterns show distinct associations, sometimes with opposite trends, across diagnostic groups, suggesting distinct underlying mechanisms that differ.","affiliation":"Department of Medical Sciences: Respiratory, Allergy and Sleep Research, Uppsala University, Uppsala, Sweden.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1183/23120541.00190-2026"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13750559"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13750559?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"Y","license":"cc by-nc","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["nct"]},"dateOfCompletion":"2026-11-11","dateOfCreation":"2026-11-11","dateOfRevision":"2026-11-12","electronicPublicationDate":"2026-11-09","firstPublicationDate":"2026-11-09","firstIndexDate":"2026-11-12","fullTextReceivedDate":"2026-11-11","hasEvaluations":"N"},{"id":"42691683","source":"MED","pmid":"42691683","doi":"10.1016/j.pedn.2026.08.057","title":"Changes in adolescents' asthma knowledge, social support-seeking behaviors, and asthma self-management following an online peer support program.","authorString":"Nouh FM, Abualruz H, Barghouthi ED, Qutishat M, Salama AH, Emara H, Ashour ESS, Mansour SF.","authorList":{"author":[{"fullName":"Nouh FM","lastName":"Nouh","firstName":"Faten Mabrouk","initials":"FM","authorId":{"type":"ORCID","value":"0009-0001-4379-5881"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Nursing, Al-Zaytoonah University of Jordan (ZUJ), Amman, Jordan. Electronic address: f.nouh@zuj.edu.jo."}]}},{"fullName":"Abualruz H","lastName":"Abualruz","firstName":"Hasan","initials":"H","authorId":{"type":"ORCID","value":"0000-0003-1523-6772"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Nursing, Al-Zaytoonah University of Jordan (ZUJ), Amman, Jordan."}]}},{"fullName":"Barghouthi ED","lastName":"Barghouthi","firstName":"Eba'a Da'san","initials":"ED","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Nursing, Al-Zaytoonah University of Jordan (ZUJ), Amman, Jordan. Electronic address: e.dasan@zuj.edu.jo."}]}},{"fullName":"Qutishat M","lastName":"Qutishat","firstName":"Mohammed","initials":"M","authorId":{"type":"ORCID","value":"0000-0001-9501-6109"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of nursing, college of science and humanities, Fahad bin sultan university, Tabuk, Saudi Arabia. Electronic address: mqutishat@fbsu.edu.sa."}]}},{"fullName":"Salama AH","lastName":"Salama","firstName":"A H","initials":"AH","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pediatric Nursing Department, Faculty of Nursing, Menoufia University, Egypt. Electronic address: aliaa.salama13@nursing.menofia.edu.eg."}]}},{"fullName":"Emara H","lastName":"Emara","firstName":"Hend","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pediatric Nursing Department, Faculty of Nursing, Menoufia University, Egypt. Electronic address: hend.mohammed45@nursing.menofia.edu.eg."}]}},{"fullName":"Ashour ESS","lastName":"Ashour","firstName":"Eman Saif Soliman","initials":"ESS","authorId":{"type":"ORCID","value":"0009-0009-2638-1263"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Nursing, Al Salam University, Egypt; Faculty of Nursing, Menoufia University, Menoufia, Egypt."}]}},{"fullName":"Mansour SF","lastName":"Mansour","firstName":"Samar F","initials":"SF","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pediatric Nursing Department, Faculty of Nursing, Menoufia University, Egypt."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-9501-6109"},{"type":"ORCID","value":"0000-0002-6813-7842"},{"type":"ORCID","value":"0000-0003-1523-6772"},{"type":"ORCID","value":"0009-0001-4379-5881"},{"type":"ORCID","value":"0009-0009-2638-1263"}]},"journalInfo":{"volume":"91","journalIssueId":4252288,"dateOfPublication":"2026 Sep","monthOfPublication":9,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"J Pediatr Nurs","title":"Journal of pediatric nursing","essn":"1532-8449","issn":"0882-5963","nlmid":"8607529","isoabbreviation":"J Pediatr Nurs"},"printPublicationDate":"2026-09-01"},"pubYear":"2026","pageInfo":"642-651","abstractText":"<h4>Background</h4>Adolescents with asthma often experience inadequate disease knowledge, limited social support, and poor self-management, which may adversely affect asthma control and quality of life. Online peer support programs offer a promising approach to complement conventional asthma education by addressing both educational and psychosocial needs.<h4>Aim</h4>To examine changes in adolescents' asthma knowledge, social support-seeking behaviors, and asthma self-management following participation in an online peer support program.<h4>Methods</h4>A one-group quasi-experimental pretest-posttest study was conducted among 50 adolescents (12-16 years) with physician-diagnosed asthma attending two outpatient pulmonary clinics in Egypt. Participants completed validated questionnaires assessing asthma knowledge, social support-seeking behaviors, and asthma self-management before and after an 8-week nurse-supervised online peer support program delivered through WhatsApp and Microsoft Teams.<h4>Results</h4>Significant improvements were observed following the intervention. Mean asthma knowledge scores increased from 25.98 ± 4.19 to 39.40 ± 1.34 (p < .001), social support-seeking behavior scores increased from 13.90 ± 1.72 to 29.34 ± 1.69 (p < .001), and asthma self-management scores increased from 5.10 ± 2.19 to 15.10 ± 0.99 (p < .001). Significant positive correlations emerged between asthma knowledge and social support-seeking behaviors (r = 0.465, p < .001), asthma knowledge and self-management (r = 0.311, p = .02), and social support-seeking behaviors and self-management (r = 0.582, p < .001).<h4>Conclusions</h4>Participation in the online peer support program was associated with significant improvements in asthma knowledge, social support-seeking behaviors, and asthma self-management.","affiliation":"Faculty of Nursing, Al-Zaytoonah University of Jordan (ZUJ), Amman, Jordan. Electronic address: f.nouh@zuj.edu.jo.","publicationStatus":"aheadofprint","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Journal Article"]},"keywordList":{"keyword":["Asthma","Adolescents","Asthma Self-management","Online Peer Support","Social Support-seeking Behaviors"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.pedn.2026.08.057"}]},"commentCorrectionList":{"commentCorrection":[{"source":"MED","id":"42833901","reference":"J Pediatr Nurs. 2026 Oct 5:S0882-5963(26)00502-6. doi: 10.1016/j.pedn.2026.09.051.","type":"Erratum in","orderIn":1}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCreation":"2026-09-03","dateOfRevision":"2026-10-05","electronicPublicationDate":"2026-09-03","firstPublicationDate":"2026-09-03","firstIndexDate":"2026-09-04","hasEvaluations":"N"},{"id":"42895519","source":"MED","pmid":"42895519","doi":"10.18176/jiaci.1229","title":"Positioning of Depemokimab in Uncontrolled Severe Asthma.","authorString":"Miralles-López JC, García-Moguel I, Habernau-Mena A, Rial-Prado MJ, Montoro-Ferrer A, Antolín-Amérigo D.","authorList":{"author":[{"fullName":"Miralles-López JC","lastName":"Miralles-López","firstName":"Juan Carlos","initials":"JC","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Allergy Department, Hospital General Universitario Reina Sofía, Murcia, Spain."},{"affiliation":"SEAIC Asthma Committee."}]}},{"fullName":"García-Moguel I","lastName":"García-Moguel","firstName":"Ismael","initials":"I","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"SEAIC Asthma Committee."},{"affiliation":"Allergy Department, Hospital Universitario 12 de Octubre, Madrid, Spain."},{"affiliation":"Instituto de Investigación Sanitaria Hospital 12 de Octubre (imas12), Madrid, Spain."}]}},{"fullName":"Habernau-Mena A","lastName":"Habernau-Mena","firstName":"Alicia","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"SEAIC Asthma Committee."},{"affiliation":"Allergy Department, Complejo Hospitalario de Mérida, Badajoz, Spain."}]}},{"fullName":"Rial-Prado MJ","lastName":"Rial-Prado","firstName":"Manuel Jorge","initials":"MJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"SEAIC Asthma Committee."},{"affiliation":"Allergy Department, Complexo Hospitalario Universitario Ferrol, A Coruña, Spain."},{"affiliation":"Instituto de investigación biomédica de A Coruña (INIBIC), A Coruña, Spain."},{"affiliation":"CIBER of Respiratory Diseases (CIBERES), Madrid, Spain."}]}},{"fullName":"Montoro-Ferrer A","lastName":"Montoro-Ferrer","firstName":"Ana","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"SEAIC Asthma Committee."},{"affiliation":"Allergy Department, Hospital General de Villarrobledo, Albacete, Spain."}]}},{"fullName":"Antolín-Amérigo D","lastName":"Antolín-Amérigo","firstName":"Darío","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"SEAIC Asthma Committee."},{"affiliation":"Allergy Department, Hospital Universitario Ramón y Cajal, Madrid, Spain."},{"affiliation":"Instituto Ramón y Cajal de Investigación Sanitaria (IRYCIS), Madrid, Spain."}]}}]},"journalInfo":{"journalIssueId":4276734,"dateOfPublication":"2026 Oct","monthOfPublication":10,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"J Investig Allergol Clin Immunol","title":"Journal of investigational allergology & clinical immunology","issn":"1018-9068","nlmid":"9107858","isoabbreviation":"J Investig Allergol Clin Immunol"},"printPublicationDate":"2026-10-01"},"pubYear":"2026","pageInfo":"0","abstractText":"Asthma is a chronic inflammatory disease of the airways affecting more than 300 million people worldwide. It is estimated that between 3% and 10% have severe asthma. Depemokimab is the first ultra-long-acting anti-IL-5 monoclonal antibody developed for type 2 respiratory disease, enabling administration every 26 weeks. It produces rapid and sustained reductions in blood eosinophil counts. This twice-yearly regimen markedly reduces injection frequency and may lessen treatment burden. In the replicate phase 3 SWIFT-1 and SWIFT-2 trials, depemokimab reduced the pooled annualized rate of clinically significant exacerbations by 54% and exacerbations requiring hospitalization or emergency department care by 72% compared with placebo in patients aged 12 years or older with severe eosinophilic asthma. In chronic rhinosinusitis with nasal polyps (CRSwNP), depemokimab was evaluated in the replicate phase 3 ANCHOR-1 and ANCHOR-2 trials. Both coprimary endpoints were met, and these studies provide evidence that twice-yearly depemokimab reduces the endoscopic nasal polyp score and improves nasal obstruction over 52 weeks in inadequately controlled CRSwNP. Depemokimab is approved for both severe asthma with type 2 inflammation and severe CRSwNP, making it a therapeutic option when both conditions coexist. Based on currently available evidence, depemokimab represents an additional option for patients with severe eosinophilic asthma in whom prevention of exacerbation is a major therapeutic goal. The twice-yearly dosing schedule may also be relevant when reducing treatment burden is a patient priority, although the effect of this reduction on adherence and persistence remains to be proved.","affiliation":"Allergy Department, Hospital General Universitario Reina Sofía, Murcia, Spain.","publicationStatus":"aheadofprint","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Review","Journal Article"]},"keywordList":{"keyword":["Asthma","Algorithm","Medication Adherence","Antiasthmatic Agents","Depemokimab"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.18176/jiaci.1229"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"N","hasTextMinedTerms":"N","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCreation":"2026-10-19","dateOfRevision":"2026-10-19","electronicPublicationDate":"2026-10-19","firstPublicationDate":"2026-10-19","firstIndexDate":"2026-10-21","hasEvaluations":"N"},{"id":"42982805","source":"MED","pmid":"42982805","pmcid":"PMC13737116","fullTextIdList":{"fullTextId":["PMC13737116"]},"doi":"10.1038/s41467-026-77643-5","title":"Meta-analysis of empirical evidence on biodiversity and the risk of asthma.","authorString":"Paciência I, Sharma N, Hugg TT, Rantala AK, Al-Delaimy WK, Jaakkola MS, Jaakkola JJK.","authorList":{"author":[{"fullName":"Paciência I","lastName":"Paciência","firstName":"Inês","initials":"I","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Environmental and Respiratory Health Research (CERH), Research Unit of Population Health, University of Oulu, Oulu, Finland."}]}},{"fullName":"Sharma N","lastName":"Sharma","firstName":"Needhi","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"University of California San Diego, San Diego, CA, USA."}]}},{"fullName":"Hugg TT","lastName":"Hugg","firstName":"Timo T","initials":"TT","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Environmental and Respiratory Health Research (CERH), Research Unit of Population Health, University of Oulu, Oulu, Finland."}]}},{"fullName":"Rantala AK","lastName":"Rantala","firstName":"Aino K","initials":"AK","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Environmental and Respiratory Health Research (CERH), Research Unit of Population Health, University of Oulu, Oulu, Finland."}]}},{"fullName":"Al-Delaimy WK","lastName":"Al-Delaimy","firstName":"Wael K","initials":"WK","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"University of California San Diego, San Diego, CA, USA."}]}},{"fullName":"Jaakkola MS","lastName":"Jaakkola","firstName":"Maritta S","initials":"MS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Environmental and Respiratory Health Research (CERH), Research Unit of Population Health, University of Oulu, Oulu, Finland."}]}},{"fullName":"Jaakkola JJK","lastName":"Jaakkola","firstName":"Jouni J K","initials":"JJK","authorId":{"type":"ORCID","value":"0000-0003-4168-4683"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Environmental and Respiratory Health Research (CERH), Research Unit of Population Health, University of Oulu, Oulu, Finland. jouni.jaakkola@oulu.fi."},{"affiliation":"Finnish Meteorological Institute, Helsinki, Finland. jouni.jaakkola@oulu.fi."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0003-4168-4683"}]},"journalInfo":{"issue":"1","volume":"17","journalIssueId":4276317,"dateOfPublication":"2026 Oct","monthOfPublication":10,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Nat Commun","title":"Nature communications","essn":"2041-1723","issn":"2041-1723","nlmid":"101528555","isoabbreviation":"Nat Commun"},"printPublicationDate":"2026-10-01"},"pubYear":"2026","pageInfo":"11396","abstractText":"Climate change and urbanization are associated with reduced greenness and vegetation diversity, depletion of biodiversity, and impoverishment of human microbiota. These changes may influence immune regulation and increase the risk of many chronic inflammatory diseases, such as asthma. This study presents the results of a meta-analysis of the association between exposure to environmental and human microbiota biodiversity and the development of asthma. The effect estimates for biodiversity were summarized as the standardized mean difference or relative risk with 95% confidence interval applying the Hedges method and the restricted maximum likelihood estimator, respectively. The summary effect estimates for the association between environmental biodiversity, using the Shannon index, and asthma was not statistically significant; whereas higher bacterial richness showed a significant protective association with asthma, although the considerable heterogeneity across the studies and publication bias. For human microbiota diversity, the summary standardized mean difference suggested that the risk of asthma was associated with high bacterial diversity and bacterial richness/abundance, while the OR‑based estimate for bacterial richness and asthma was not significant. Our meta-analysis shows variable associations between exposure to environmental and human microbiota biodiversity and asthma, with the direction and magnitude of these associations depending on the specific biodiversity metrics and analytical approaches used.","affiliation":"Center for Environmental and Respiratory Health Research (CERH), Research Unit of Population Health, University of Oulu, Oulu, Finland.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Meta-Analysis","research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Bacteria","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"CL","qualifierName":"classification"}]}},{"majorTopic_YN":"Y","descriptorName":"Asthma","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ET","qualifierName":"etiology"},{"majorTopic_YN":"N","abbreviation":"MI","qualifierName":"microbiology"},{"majorTopic_YN":"N","abbreviation":"EP","qualifierName":"epidemiology"}]}},{"majorTopic_YN":"N","descriptorName":"Risk Factors"},{"majorTopic_YN":"Y","descriptorName":"Biodiversity"},{"majorTopic_YN":"N","descriptorName":"Climate Change"},{"majorTopic_YN":"Y","descriptorName":"Microbiota"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41467-026-77643-5"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13737116"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13737116?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"N","hasData":"Y","license":"cc by-nc-nd","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-11-04","dateOfCreation":"2026-11-04","dateOfRevision":"2026-11-07","electronicPublicationDate":"2026-10-07","firstPublicationDate":"2026-10-07","firstIndexDate":"2026-11-06","fullTextReceivedDate":"2026-11-07","hasEvaluations":"N"},{"id":"42828228","source":"MED","pmid":"42828228","pmcid":"PMC13631958","fullTextIdList":{"fullTextId":["PMC13631958"]},"doi":"10.3389/fphys.2026.1947873","title":"Mechanistic advances in the regulation of asthma by different exercise modalities: an integrative perspective on exercise load characteristics and asthma heterogeneity.","authorString":"Yang S, Zhou Y.","authorList":{"author":[{"fullName":"Yang S","lastName":"Yang","firstName":"Shihan","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Sports, Minnan University of Science and Technology, Quanzhou, China."}]}},{"fullName":"Zhou Y","lastName":"Zhou","firstName":"Yingjie","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pulmonary and Critical Care Medicine, Affiliated Hospital of Shandong University of Traditional Chinese Medicine, Jinan, China."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"17","journalIssueId":4103352,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Front Physiol","title":"Frontiers in physiology","essn":"1664-042X","issn":"1664-042X","nlmid":"101549006","isoabbreviation":"Front Physiol"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"1947873","abstractText":"Asthma is a heterogeneous chronic airway disease in which exercise may act both as a trigger of respiratory symptoms and as a beneficial non-pharmacological intervention. Training responses vary across exercise modalities and asthma phenotypes; inconsistent findings for lung function, airway inflammation, bronchial hyperresponsiveness (BHR), and exercise-induced bronchoconstriction (EIB) highlight the need for a mechanism-oriented framework. This review synthesizes current evidence on moderate-intensity continuous aerobic training, high-intensity interval training, resistance training, combined aerobic-resistance training, breathing exercises, mind-body exercise, and aquatic exercise from the perspective of their dominant ventilatory, metabolic, mechanical-muscular, respiratory-behavioral, and neuropsychological loads. These load characteristics interact with different asthma phenotypes and clinical-mechanistic traits, including type 2-high eosinophilic asthma, obesity-related or non-type 2 asthma, EIB-dominant asthma, severe asthma with physical deconditioning, and dysfunctional breathing or anxiety-related symptoms. Four key mechanistic axes are examined: the ventilatory load-airway epithelium-EIB axis, immune inflammation-BHR axis, skeletal muscle-metabolic-systemic inflammation axis, and respiratory behavior-autonomic regulation-symptom perception axis. Structured exercise training provides the strongest and most consistent benefits for exercise capacity, asthma control, symptoms, and health-related quality of life.,whereas effects on airway inflammation, BHR, lung function, and EIB remain heterogeneous and appear to depend more on baseline phenotype, disease control, environmental exposure, and training protocol. The proposed mechanism-informed framework is intended to support individualized exercise selection, risk stratification, and outcome monitoring rather than serve as a fixed phenotype-specific prescription algorithm.","affiliation":"College of Sports, Minnan University of Science and Technology, Quanzhou, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Asthma","Exercise Training","Exercise-induced Bronchoconstriction","Exercise Load Characteristics","Mechanism-informed Exercise Selection"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fphys.2026.1947873"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13631958"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13631958?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["pdb","doi"]},"dateOfCompletion":"2026-10-03","dateOfCreation":"2026-10-03","dateOfRevision":"2026-10-05","electronicPublicationDate":"2026-09-18","firstPublicationDate":"2026-09-18","firstIndexDate":"2026-10-04","fullTextReceivedDate":"2026-10-05","hasEvaluations":"N"},{"id":"42447233","source":"MED","pmid":"42447233","doi":"10.1093/ajrccm/aamag373","title":"Peripubertal changes in asthma.","authorString":"Silva AE, Ferrante G, Silveyra P, Custovic A, La Grutta S, Forno E.","authorList":{"author":[{"fullName":"Silva AE","lastName":"Silva","firstName":"Alexandra E","initials":"AE","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Pulmonology, Allergy/Immunology, and Sleep Medicine, Riley Hospital for Children, Indianapolis, IN, United States."},{"affiliation":"Department of Pediatrics, Indiana University School of Medicine, Indianapolis, IN, United States."}]}},{"fullName":"Ferrante G","lastName":"Ferrante","firstName":"Giuliana","initials":"G","authorId":{"type":"ORCID","value":"0000-0001-9917-2387"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Surgery, Dentistry, Pediatrics and Gynaecology, Pediatric Division, University of Verona, Verona, Italy."},{"affiliation":"Institute of Translational Pharmacology, National Research Council, Palermo, Italy."}]}},{"fullName":"Silveyra P","lastName":"Silveyra","firstName":"Patricia","initials":"P","authorId":{"type":"ORCID","value":"0000-0001-7083-8915"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Environmental and Occupational Health, Indiana University School of Public Health-Bloomington, Bloomington, IN, United States."}]}},{"fullName":"Custovic A","lastName":"Custovic","firstName":"Adnan","initials":"A","authorId":{"type":"ORCID","value":"0000-0001-5218-7071"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Paediatric Allergy Group, Centre for Paediatrics and Child Health, Imperial College London, London, United Kingdom."}]}},{"fullName":"La Grutta S","lastName":"La Grutta","firstName":"Stefania","initials":"S","authorId":{"type":"ORCID","value":"0000-0001-8026-0715"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Translational Pharmacology, National Research Council, Palermo, Italy."}]}},{"fullName":"Forno E","lastName":"Forno","firstName":"Erick","initials":"E","authorId":{"type":"ORCID","value":"0000-0001-6497-9885"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Pulmonology, Allergy/Immunology, and Sleep Medicine, Riley Hospital for Children, Indianapolis, IN, United States."},{"affiliation":"Department of Pediatrics, Indiana University School of Medicine, Indianapolis, IN, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5218-7071"},{"type":"ORCID","value":"0000-0001-6497-9885"},{"type":"ORCID","value":"0000-0001-7083-8915"},{"type":"ORCID","value":"0000-0001-8026-0715"},{"type":"ORCID","value":"0000-0001-9917-2387"}]},"journalInfo":{"issue":"10","volume":"212","journalIssueId":4274884,"dateOfPublication":"2026 Oct","monthOfPublication":10,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Am J Respir Crit Care Med","title":"American journal of respiratory and critical care medicine","essn":"1535-4970","issn":"1073-449X","nlmid":"9421642","isoabbreviation":"Am J Respir Crit Care Med"},"printPublicationDate":"2026-10-01"},"pubYear":"2026","pageInfo":"2592-2606","abstractText":"Asthma is a heterogeneous disease affecting nearly 300 million people around the world. It is the most common chronic respiratory disease of childhood. There are significant sex differences in asthma incidence, severity, and morbidity around the time of puberty. The reasons for these peripubertal changes are still not fully understood, but they are likely multifactorial. In this review, we will discuss several proposed contributing mechanisms, including sex differences in anatomy and development, the effects of sex hormones on airway inflammation and reactivity, the immunomodulatory effects of sex hormones, differences in mucociliary function, and sex differences in genetic and epigenetic factors.","affiliation":"Division of Pulmonology, Allergy/Immunology, and Sleep Medicine, Riley Hospital for Children, Indianapolis, IN, United States.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Asthma","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"IM","qualifierName":"immunology"},{"majorTopic_YN":"N","abbreviation":"EP","qualifierName":"epidemiology"},{"majorTopic_YN":"N","abbreviation":"PP","qualifierName":"physiopathology"}]}},{"majorTopic_YN":"N","descriptorName":"Gonadal Steroid Hormones","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"PH","qualifierName":"physiology"}]}},{"majorTopic_YN":"N","descriptorName":"Sex Factors"},{"majorTopic_YN":"Y","descriptorName":"Puberty","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"PH","qualifierName":"physiology"}]}},{"majorTopic_YN":"N","descriptorName":"Child"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"}]},"keywordList":{"keyword":["Sex hormones","Asthma","Puberty","Asthma Phenotypes","Dysanapsis"]},"chemicalList":{"chemical":[{"name":"Gonadal Steroid Hormones","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1093/ajrccm/aamag373"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":2,"hasReferences":"N","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-09-30","dateOfCreation":"2026-07-14","dateOfRevision":"2026-09-30","firstPublicationDate":"2026-10-01","firstIndexDate":"2026-07-15","hasEvaluations":"N"},{"id":"42481039","source":"MED","pmid":"42481039","doi":"10.1542/hpeds.2025-009049","title":"Inpatient Childhood Asthma Controller Medication Escalation and Increased Time-to-Readmission.","authorString":"Syed A, McCurvin J, Larkin A, Butler G, Joe A, Forster C, Celedón JC, Han YY, Rosser F.","authorList":{"author":[{"fullName":"Syed A","lastName":"Syed","firstName":"Arsala","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Pediatric Hospital Medicine, UPMC Children's Hospital of Pittsburgh, Pittsburgh, Pennsylvania."}]}},{"fullName":"McCurvin J","lastName":"McCurvin","firstName":"Jade","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Pulmonary Medicine, University of Pittsburgh School of Medicine, Pittsburgh, Pennsylvania."}]}},{"fullName":"Larkin A","lastName":"Larkin","firstName":"Allyson","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Allergy and Immunology, UPMC Children's Hospital of Pittsburgh, Pittsburgh, Pennsylvania."}]}},{"fullName":"Butler G","lastName":"Butler","firstName":"Gabriella","initials":"G","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Health Informatics, UPMC Children's Hospital of Pittsburgh, Pittsburgh, Pennsylvania."}]}},{"fullName":"Joe A","lastName":"Joe","firstName":"Allen","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Pulmonary Medicine, University of Pittsburgh School of Medicine, Pittsburgh, Pennsylvania."}]}},{"fullName":"Forster C","lastName":"Forster","firstName":"Catherine","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Pediatric Hospital Medicine, UPMC Children's Hospital of Pittsburgh, Pittsburgh, Pennsylvania."}]}},{"fullName":"Celedón JC","lastName":"Celedón","firstName":"Juan C","initials":"JC","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Pulmonary Medicine, University of Pittsburgh School of Medicine, Pittsburgh, Pennsylvania."}]}},{"fullName":"Han YY","lastName":"Han","firstName":"Yueh-Ying","initials":"YY","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Pulmonary Medicine, University of Pittsburgh School of Medicine, Pittsburgh, Pennsylvania."}]}},{"fullName":"Rosser F","lastName":"Rosser","firstName":"Franziska","initials":"F","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Pulmonary Medicine, University of Pittsburgh School of Medicine, Pittsburgh, Pennsylvania."}]}}]},"journalInfo":{"issue":"10","volume":"16","journalIssueId":4275320,"dateOfPublication":"2026 Oct","monthOfPublication":10,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Hosp Pediatr","title":"Hospital pediatrics","essn":"2154-1671","issn":"2154-1663","nlmid":"101585349","isoabbreviation":"Hosp Pediatr"},"printPublicationDate":"2026-10-01"},"pubYear":"2026","pageInfo":"896-905","abstractText":"<h4>Background</h4>Childhood asthma readmission rates are unacceptably high. Whether increasing asthma therapy during hospitalization prevents readmission is unknown.<h4>Objective</h4>To determine if an asthma medication escalation in children hospitalized for an asthma exacerbation is associated with increased time-to-readmission for asthma.<h4>Methods</h4>Retrospective cohort study of children aged 5 to 17 years admitted for an asthma exacerbation at our institution from 2021 to 2023. An escalation in asthma controller medication was defined as initiation of an asthma controller, increase in step therapy, or addition of a new controller class. The primary outcome was time-to-readmission for an asthma exacerbation.<h4>Results</h4>Among 986 children admitted for an asthma exacerbation, asthma medication was escalated in 33%, not escalated in 47%, and undetermined in 20%; 25% were readmitted for asthma. Children who were readmitted were younger and more likely to live in a ZIP code with high asthma rates, have public insurance, a previous emergency department visit, identify as Black, and a higher therapy on discharge than those not readmitted. In adjusted analyses (n = 790), an escalation was associated with lower risk of readmission (hazard ratio [HR] = 0.65, 95% CI  0.46-0.91, P = 0.01). In stratified analyses, an escalation was associated with a reduced HR of readmission if discharged by the pulmonary (HR = 0.43, 95% CI 0.27-0.69) but not by hospital medicine (HR = 1.05, 95% CI 0.68-1.63) service.<h4>Conclusion</h4>Inpatient escalation of controller therapy is associated with reduced hazard of readmission for asthma. Further studies are needed to determine optimal discharge asthma therapy management.","affiliation":"Division of Pediatric Hospital Medicine, UPMC Children's Hospital of Pittsburgh, Pittsburgh, Pennsylvania.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Asthma","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"DT","qualifierName":"drug therapy"}]}},{"majorTopic_YN":"Y","descriptorName":"Anti-Asthmatic Agents","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AD","qualifierName":"administration & dosage"},{"majorTopic_YN":"N","abbreviation":"TU","qualifierName":"therapeutic use"}]}},{"majorTopic_YN":"Y","descriptorName":"Patient Readmission","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"SN","qualifierName":"statistics & numerical data"}]}},{"majorTopic_YN":"N","descriptorName":"Retrospective Studies"},{"majorTopic_YN":"N","descriptorName":"Adolescent"},{"majorTopic_YN":"N","descriptorName":"Child"},{"majorTopic_YN":"N","descriptorName":"Child, Preschool"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"}]},"chemicalList":{"chemical":[{"name":"Anti-Asthmatic Agents","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1542/hpeds.2025-009049"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-09-30","dateOfCreation":"2026-07-21","dateOfRevision":"2026-09-30","firstPublicationDate":"2026-10-01","firstIndexDate":"2026-07-22","hasEvaluations":"N"},{"id":"42936187","source":"MED"