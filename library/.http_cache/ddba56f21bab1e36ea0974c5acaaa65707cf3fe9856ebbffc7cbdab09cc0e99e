"]},"chemicalList":{"chemical":[{"name":"Air Pollutants","registryNumber":"0"},{"name":"Biomarkers","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1007/s11882-026-01293-2"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-09-15","dateOfCreation":"2026-09-15","dateOfRevision":"2026-11-05","electronicPublicationDate":"2026-09-15","firstPublicationDate":"2026-09-15","firstIndexDate":"2026-09-16","hasEvaluations":"N"},{"id":"42980725","source":"MED","pmid":"42980725","pmcid":"PMC13736361","fullTextIdList":{"fullTextId":["PMC13736361"]},"doi":"10.1007/s11882-026-01304-2","title":"Asthma in Older Adults: A Systematic Review of Real-World Burden and Outcomes.","authorString":"Chen ZQ, Sun ZW, Sun HK, Wang DY, Ma W.","authorList":{"author":[{"fullName":"Chen ZQ","lastName":"Chen","firstName":"Zi-Qi","initials":"ZQ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Respiratory Medicine, The First School of Clinical Medicine, Guangdong Medical University, Zhanjiang, 524023, China."}]}},{"fullName":"Sun ZW","lastName":"Sun","firstName":"Zi-Wen","initials":"ZW","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Respiratory Medicine, School of Medicine, South China University of Technology, Guangzhou, 510000, China."}]}},{"fullName":"Sun HK","lastName":"Sun","firstName":"Hua-Ke","initials":"HK","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Geriatric Medicine, Guangzhou First People's Hospital, School of Medicine, South China University of Technology, Guangzhou, China."}]}},{"fullName":"Wang DY","lastName":"Wang","firstName":"De-Yun","initials":"DY","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Otolaryngology, Yong Loo Lin School of Medicine, National University of Singapore, Singapore, 119228, Singapore. entwdy@nus.edu.sg."}]}},{"fullName":"Ma W","lastName":"Ma","firstName":"Wei","initials":"W","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Respiratory Medicine Guangzhou First People's Hospital, Guangdong Medical University, Zhanjiang, 524023, China. eymawei@scut.edu.cn."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"26","journalIssueId":4307718,"dateOfPublication":"2026 Nov","monthOfPublication":11,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Curr Allergy Asthma Rep","title":"Current allergy and asthma reports","essn":"1534-6315","issn":"1529-7322","nlmid":"101096440","isoabbreviation":"Curr Allergy Asthma Rep"},"printPublicationDate":"2026-11-01"},"pubYear":"2026","pageInfo":"62","abstractText":"<h4>Purpose of review</h4>This review examines asthma in older adults over the past decade, focusing on epidemiology, diagnostic challenges, and current management. It also explores why asthma remains underdiagnosed and undertreated in this population.<h4>Recent findings</h4>Asthma prevalence is increasing among older adults worldwide, particularly in developed regions and Asia, yet underdiagnosis and undertreatment remain common. Diagnostic complexity is driven by atypical presentations, comorbidities, overlapping COPD features, and limitations of standard diagnostic criteria. Patient-related barriers include low health literacy, poor inhaler technique, symptom misattribution, psychological comorbidity, and limited social support. Access to biologic therapies remains uneven, and precision medicine approaches for older adults are lacking. Asthma in older adults is an important and underrecognized public health issue. Better awareness, age-adapted diagnostic protocols, improved inhaler education, and more integrated management of comorbidities are needed to improve outcomes and quality of life.","affiliation":"Department of Respiratory Medicine, The First School of Clinical Medicine, Guangdong Medical University, Zhanjiang, 524023, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Systematic Review","review-article","Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Asthma","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"DI","qualifierName":"diagnosis"},{"majorTopic_YN":"N","abbreviation":"EP","qualifierName":"epidemiology"},{"majorTopic_YN":"N","abbreviation":"TH","qualifierName":"therapy"}]}},{"majorTopic_YN":"N","descriptorName":"Prevalence"},{"majorTopic_YN":"N","descriptorName":"Comorbidity"},{"majorTopic_YN":"N","descriptorName":"Cost of Illness"},{"majorTopic_YN":"N","descriptorName":"Quality of Life"},{"majorTopic_YN":"N","descriptorName":"Aged"}]},"keywordList":{"keyword":["Diagnosis","epidemiology","Comorbidities","Elderly Asthma","Real-world Studies"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1007/s11882-026-01304-2"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13736361"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13736361?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"Y","license":"cc by-nc-nd","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-11-04","dateOfCreation":"2026-11-04","dateOfRevision":"2026-11-10","electronicPublicationDate":"2026-11-04","firstPublicationDate":"2026-11-04","firstIndexDate":"2026-11-05","fullTextReceivedDate":"2026-11-07","hasEvaluations":"N"},{"id":"42966531","source":"MED","pmid":"42966531","pmcid":"PMC13739236","fullTextIdList":{"fullTextId":["PMC13739236"]},"doi":"10.1016/j.anai.2026.10.033","title":"Childhood opportunity and outcomes in outpatient children seeking specialty care for asthma in Atlanta, Georgia.","authorString":"Fitzpatrick AM, Mason C, Grunwell JR.","authorList":{"author":[{"fullName":"Fitzpatrick AM","lastName":"Fitzpatrick","firstName":"Anne M","initials":"AM","authorId":{"type":"ORCID","value":"0000-0002-2933-5926"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Emory University, Department of Pediatrics, Atlanta, Georgia; Children's Healthcare of Atlanta, Division of Pulmonary Medicine, Atlanta, Georgia. Electronic address: anne.fitzpatrick@emory.edu."}]}},{"fullName":"Mason C","lastName":"Mason","firstName":"Carrie","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Children's Healthcare of Atlanta, Division of Pulmonary Medicine, Atlanta, Georgia."}]}},{"fullName":"Grunwell JR","lastName":"Grunwell","firstName":"Jocelyn R","initials":"JR","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Emory University, Department of Pediatrics, Atlanta, Georgia; Children's Healthcare of Atlanta, Division of Critical Care Medicine, Atlanta, Georgia."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2933-5926"}]},"journalInfo":{"journalIssueId":4277025,"dateOfPublication":"2026 Oct","monthOfPublication":10,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Ann Allergy Asthma Immunol","title":"Annals of allergy, asthma & immunology : official publication of the American College of Allergy, Asthma, & Immunology","essn":"1534-4436","issn":"1081-1206","nlmid":"9503580","isoabbreviation":"Ann Allergy Asthma Immunol"},"printPublicationDate":"2026-10-01"},"pubYear":"2026","pageInfo":"S1081-1206(26)01327-X","abstractText":"<h4>Background</h4>Resource limitation can significantly impact asthma outcomes in children but has not been adequately studied in children with inadequately controlled asthma accessing specialty care.<h4>Objective</h4>This study leveraged the Childhood Opportunity Index (COI) version 3.0, a validated quantitative measure of 44 indicators independent of participant demographics, to characterize the multiple types of resources available to children accessing specialty care for asthma based on their neighborhood residence.<h4>Methods</h4>Four hundred forty-one outpatient children accessing specialty care for inadequately controlled asthma were enrolled and completed questionnaires and measures of aeroallergen sensitization and lung function. Questionnaires were repeated at 6 to 12 months. Childhood opportunity for each participant was characterized with the metropolitan-normed COI version 3.0, using coordinate geographies.<h4>Results</h4>Sixty three percent of enrolled children lived in \"very low\" or \"low\" opportunity neighborhoods based on COI 3.0 benchmarks. Children residing in lower opportunity neighborhoods were more racially minoritized with lesser household education and income. These children also had more multimorbidity, more asthma triggers and allergic sensitization, and poorer asthma-related quality of life with lower lung function. Children from lower opportunity neighborhoods were less likely to follow up, but in those who did, poorer quality of life persisted despite no significant differences in exacerbations or healthcare utilization.<h4>Conclusion</h4>Children accessing specialty care for asthma may have significant resource needs. While these results may not generalize to other centers, they demonstrate the need for alternative care interventions in the lowest resourced children to improve asthma outcomes.","affiliation":"Emory University, Department of Pediatrics, Atlanta, Georgia; Children's Healthcare of Atlanta, Division of Pulmonary Medicine, Atlanta, Georgia. Electronic address: anne.fitzpatrick@emory.edu.","publicationStatus":"aheadofprint","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"agency":"NHLBI NIH HHS","acronym":"HL","grantId":"R01 HL177826","orderIn":0},{"agency":"NCATS NIH HHS","acronym":"TR","grantId":"UL1 TR002378","orderIn":0}]},"keywordList":{"keyword":["Asthma Control","Asthma Exacerbation","Social Determinants Of Health","Childhood Opportunity"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.anai.2026.10.033"},{"availability":"Free","availabilityCode":"F","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13739236"},{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13739236?pdf=render"},{"availability":"Free","availabilityCode":"F","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.anai.2026.10.033"}]},"isOpenAccess":"N","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","authMan":"Y","epmcAuthMan":"N","nihAuthMan":"Y","manuscriptId":"NIHMS2220681","hasTMAccessionNumbers":"N","dateOfCreation":"2026-10-31","dateOfRevision":"2026-11-07","electronicPublicationDate":