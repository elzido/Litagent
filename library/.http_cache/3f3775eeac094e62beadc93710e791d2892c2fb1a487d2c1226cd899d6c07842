ssionNumbers":"Y","tmAccessionTypeList":{"accessionType":["gen"]},"dateOfCompletion":"2026-11-02","dateOfCreation":"2026-10-01","dateOfRevision":"2026-11-02","electronicPublicationDate":"2026-09-30","firstPublicationDate":"2026-09-30","firstIndexDate":"2026-10-01","fullTextReceivedDate":"2026-11-03","hasEvaluations":"N"},{"id":"42957818","source":"MED","pmid":"42957818","pmcid":"PMC13719926","fullTextIdList":{"fullTextId":["PMC13719926"]},"doi":"10.1007/s00253-026-13976-x","title":"T cell engineering by targeted small extracellular vesicles delivering CRISPR/Cas9 system for PD-1 knock-out.","authorString":"Farahani MS, Shamsara M, Moazzeni SM, Khalili S, Johnson B, Darzi L, Shoae M, Ghavami M, Razi A, Hosseini-Beheshti E, Moghadam MF.","authorList":{"author":[{"fullName":"Farahani MS","lastName":"Farahani","firstName":"Mahboube Shahrabi","initials":"MS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical Biotechnology, Faculty of Medical Sciences, Tarbiat Modares University, I.R, Jalal Ale Ahmad Highway, P.O. Box 14115-331, Tehran, Iran."}]}},{"fullName":"Shamsara M","lastName":"Shamsara","firstName":"Mehdi","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Animal Biotechnology, Faculty of Agriculture Biotechnology, National Institute of Genetic Engineering and Biotechnology, Tehran, Iran."}]}},{"fullName":"Moazzeni SM","lastName":"Moazzeni","firstName":"Seyed Mohammad","initials":"SM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical Immunology, Faculty of Medical Sciences, Tarbiat Modares University, Tehran, Iran."}]}},{"fullName":"Khalili S","lastName":"Khalili","firstName":"Saeed","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical Biotechnology, Faculty of Medical Sciences, Tarbiat Modares University, I.R, Jalal Ale Ahmad Highway, P.O. Box 14115-331, Tehran, Iran."}]}},{"fullName":"Johnson B","lastName":"Johnson","firstName":"Ben","initials":"B","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Asbestos and Dust Diseases Research Institute (ADDRI), Sydney, NSW, Australia."}]}},{"fullName":"Darzi L","lastName":"Darzi","firstName":"Leila","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical Biotechnology, Faculty of Medical Sciences, Tarbiat Modares University, I.R, Jalal Ale Ahmad Highway, P.O. Box 14115-331, Tehran, Iran."}]}},{"fullName":"Shoae M","lastName":"Shoae","firstName":"Mohammad","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical Biotechnology, Faculty of Medical Sciences, Tarbiat Modares University, I.R, Jalal Ale Ahmad Highway, P.O. Box 14115-331, Tehran, Iran."}]}},{"fullName":"Ghavami M","lastName":"Ghavami","firstName":"Mahlegha","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"BC Children's Hospital Research Institute, Vancouver, British Columbia, Canada."}]}},{"fullName":"Razi A","lastName":"Razi","firstName":"Abdolah","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Urology, Faculty of Medicine, North Khorasan University of Medical Sciences, Bojnord, Iran."}]}},{"fullName":"Hosseini-Beheshti E","lastName":"Hosseini-Beheshti","firstName":"Elham","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Asbestos and Dust Diseases Research Institute (ADDRI), Sydney, NSW, Australia."}]}},{"fullName":"Moghadam MF","lastName":"Moghadam","firstName":"Mehdi Forouzandeh","initials":"MF","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical Biotechnology, Faculty of Medical Sciences, Tarbiat Modares University, I.R, Jalal Ale Ahmad Highway, P.O. Box 14115-331, Tehran, Iran. foroz@modares.ac.ir."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"110","journalIssueId":4241744,"dateOfPublication":"2026 Aug","monthOfPublication":8,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Appl Microbiol Biotechnol","title":"Applied microbiology and biotechnology","essn":"1432-0614","issn":"0175-7598","isoabbreviation":"Appl Microbiol Biotechnol","nlmid":"8406612"},"printPublicationDate":"2026-08-01"},"pubYear":"2026","pageInfo":"325","abstractText":"Among the emerging cancer therapies, immunotherapy using T cell engineering stands out as one of the most promising approaches. While the clustered regularly interspaced palindromic repeats (CRISPR/Cas) system is widely recognized as one of the most common gene-editing system tools, the main challenge for in vivo delivery applications remains the lack of an efficient and safe intracellular carrier. Small extracellular vesicles (s-EVs), as natural nanoparticles with low immunogenicity, emerge as a promising candidate for delivering the CRISPR/Cas system. Two guide RNAs (gRNAs) targeting the programmed cell death (PD-1) gene were cloned into the PX-459 vector, and these CRISPR/Cas9 plasmids were loaded into targeted s-EVs by electroporation. Subsequently, T cells were exposed to these s-EVs, and the disruption to the PD-1 gene was examined using flow cytometry and sequencing. Flow cytometry results indicated that newly produced targeted s-EVs exhibited a higher uptake by T cells compared to non-targeted s-EVs. The successful loading of PX-459 plasmids into targeted s-EVs and their functional delivery to T cells were confirmed. Subsequent carboxyfluorescein succinimidyl ester (CFSE) staining and enzyme-linked immunosorbent assay (ELISA) analyses demonstrated that the knockout (KO) of the PD-1 gene in T cells significantly enhanced both their cytotoxicity and cytokine release compared to untreated T cells. Targeted s-EVs were used in the current study as a means to deliver the CRISPR/Cas9 system into T cells, enabling genetic modification of target cells. This approach holds the potential to improve and simplify immunotherapy. This study demonstrates a novel approach to genetic modification in T cells using targeted s-EVs containing the CRISPR/Cas9 gene-editing system. KEY POINTS: •CRISPR/Cas9 is a kind of powerful gene editing system in cancer therapeutics. •s-EVs can be applied as a biological carrier for CRISPR/Cas9 system. • T cell engineering-based immunotherapy is a promising form of anticancer therapy.","affiliation":"Department of Medical Biotechnology, Faculty of Medical Sciences, Tarbiat Modares University, I.R, Jalal Ale Ahmad Highway, P.O. Box 14115-331, Tehran, Iran.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"Y","descriptorName":"T-Lymphocytes","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"IM","qualifierName":"immunology"},{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Electroporation"},{"majorTopic_YN":"N","descriptorName":"Plasmids"},{"majorTopic_YN":"Y","descriptorName":"Gene Knockout Techniques","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}},{"majorTopic_YN":"Y","descriptorName":"Programmed Cell Death 1 Receptor","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Cell Engineering","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}},{"majorTopic_YN":"Y","descriptorName":"CRISPR-Cas Systems"},{"majorTopic_YN":"Y","descriptorName":"Extracellular Vesicles","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifier