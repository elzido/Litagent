ion":[{"affiliation":"Key Laboratory of Animal Biosafety Risk Prevention and Control (North) & Key Laboratory of Veterinary Biological Products and Chemical Drugs of MARA, Institute of Animal Science, Chinese Academy of Agricultural Sciences, Beijing 100193, China."}]}},{"fullName":"Hu D","lastName":"Hu","firstName":"Dandan","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Animal Science and Technology, Guangxi University, Guangxi 541000, China."}]}},{"fullName":"Si H","lastName":"Si","firstName":"Hongbin","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Animal Science and Technology, Guangxi University, Guangxi 541000, China."}]}},{"fullName":"Song X","lastName":"Song","firstName":"Xingju","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Animal Science and Technology, Guangxi University, Guangxi 541000, China."}]}},{"fullName":"Tang X","lastName":"Tang","firstName":"Xinming","initials":"X","authorId":{"type":"ORCID","value":"0000-0003-0127-1235"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Key Laboratory of Animal Biosafety Risk Prevention and Control (North) & Key Laboratory of Veterinary Biological Products and Chemical Drugs of MARA, Institute of Animal Science, Chinese Academy of Agricultural Sciences, Beijing 100193, China. Electronic address: tangxinming@caas.cn."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-8515-9031"},{"type":"ORCID","value":"0000-0003-0127-1235"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"6","volume":"105","journalIssueId":4202915,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Poult Sci","title":"Poultry science","essn":"1525-3171","issn":"0032-5791","isoabbreviation":"Poult Sci","nlmid":"0401150"},"printPublicationDate":"2026-06-01"},"pubYear":"2026","pageInfo":"106763","abstractText":"Gene editing technology has been widely applied in the genetic manipulation of many organisms and is increasingly being utilized in eukaryotic pathogens. However, its efficiency often requires improvement. In our study using CRISPR/Cas9 to genetically manipulate Eimeria tenella, we aimed to insert a tag into a target gene locus via homologous recombination, but observed outcomes inconsistent with expectations. Whole-genome sequencing analysis of the integration sites revealed that the transgenic E. tenella did not exhibit correct targeted integration. These results indicate that creating double-strand breaks (DSB) at specific genomic sites to trigger homology-directed repair (HDR) for gene modification can lead to mislocalized expression. This study provides insights for utilizing CRISPR/Cas9 technology in genetic editing, particularly in E. tenella, and offers suggestions for improving strategies that employ the co-transfection of multiple plasmids, such as Cas9-gRNA and donor plasmids.","affiliation":"College of Animal Science and Technology, Guangxi University, Guangxi 541000, China; Key Laboratory of Animal Biosafety Risk Prevention and Control (North) & Key Laboratory of Veterinary Biological Products and Chemical Drugs of MARA, Institute of Animal Science, Chinese Academy of Agricultural Sciences, Beijing 100193, China.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"agency":"Agricultural Science and Technology Innovation Program","grantId":"ASTIP-IAS15","orderIn":0},{"agency":"National Natural Science Foundation of China","grantId":"32273035","orderIn":0},{"agency":"Chinese Academy of Agricultural Sciences","grantId":"Y2023QC10","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Chickens"},{"majorTopic_YN":"Y","descripto