lastName":"Guo","firstName":"Yanping","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Flow Cytometry Translational Technology Platform, University College London, London, UK."}]}},{"fullName":"Look AT","lastName":"Look","firstName":"A Thomas","initials":"AT","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pediatric Oncology, Dana-Farber Cancer Institute, Harvard Medical School, Boston, MA, USA; Division of Pediatric Hematology-Oncology, Boston Children's Hospital, Boston, MA, USA."}]}},{"fullName":"Mansour MR","lastName":"Mansour","firstName":"Marc R","initials":"MR","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Haematology, UCL Cancer Institute, University College London, London, UK; Developmental Biology and Cancer, UCL Great Ormond Street Institute of Child Health, London, UK; University College London Hospitals NHS Foundation Trust, London, UK. Electronic address: m.mansour@ucl.ac.uk."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"3","volume":"7","journalIssueId":4252119,"dateOfPublication":"2026 Sep","monthOfPublication":9,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"STAR Protoc","title":"STAR protocols","essn":"2666-1667","issn":"2666-1667","isoabbreviation":"STAR Protoc","nlmid":"101769501"},"printPublicationDate":"2026-09-01"},"pubYear":"2026","pageInfo":"104817","abstractText":"Jurkat cells are a versatile cell-line model utilized across multiple areas of biology. Here, we present a protocol for inserting DNA sequences (knockins) at an endogenous locus using CRISPR-Cas9 technology via homology-directed repair (HDR). We describe steps for designing, constructing, and validating endogenous knockins in T-ALL Jurkat cells. This protocol has potential application in gene regulatory studies, cancer biology, HIV research, and T-cell signaling, among others. For complete details on the use and execution of this protocol, please refer to Costa JR et al.<sup>1</sup>.","affiliation":"Department of Haematology, UCL Cancer Institute, University College London, London, UK. Electronic address: joana.rodrigues-simoes-da-costa@lsbu.ac.uk.","publicationStatus":"aheadofprint","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Molecular biology","Cell biology","Flow cytometry","Cancer","Cell culture","Crispr","Cell-based Assays"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.xpro.2026.104817"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13583563"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13583563?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCreation":"2026-09-18","dateOfRevision":"2026-09-22","electronicPublicationDate":"2026-09-11","firstPublicationDate":"2026-09-11","firstIndexDate":"2026-09-19","fullTextReceivedDate":"2026-09-18","hasEvaluations":"N"},{"id":"42291973","source":"MED","pmid":"42291973","pmcid":"PMC13254413","fullTextIdList":{"fullTextId":["PMC13254413"]},"doi":"10.7759/cureus.108691","title":"CRISPR-Cas9-Mediated Gene Editing in Hematological Disorders: Advancing Translational and Clinical Applications.","authorString":"Singh A, Kumar R, Chauhan P, Mallikarjuna M, Thaker R, Sambhav K.","authorList":{"author":[{"fullName":"Singh A","lastName":"Singh","firstName":"Abhay","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Transfusion Medicine, Uttar Pradesh University of Medical Sciences, Saifai, IND."}]}},{"fullName":"Kumar R","lastName":"Kumar","firstName":"Rishikesh","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Microbiology, Indira Gandhi Institute of Medical Science, Patna, IND."}]}},{"fullName":"Chauhan P","lastName":"Chauhan","firstName":"Pradip","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Anatomy, All India Institute of Medical Sciences, Rajkot, Rajkot, IND."}]}},{"fullName":"Mallikarjuna M","lastName":"Mallikarjuna","firstName":"Mallu","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Virology, Sri Venkateswara University, Tirupati, IND."}]}},{"fullName":"Thaker R","lastName":"Thaker","firstName":"Ravi","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Physiology, Dr. N.D. Desai Faculty of Medical Science and Research, Dharmsinh Desai University, Nadiad, IND."}]}},{"fullName":"Sambhav K","lastName":"Sambhav","firstName":"Kumar","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Anatomy, All India Institute of Medical Sciences, Bilaspur, Bilaspur, IND."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"5","volume":"18","journalIssueId":4188949,"dateOfPublication":"2026 May","monthOfPublication":5,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Cureus","title":"Cureus","essn":"2168-8184","issn":"2168-8184","isoabbreviation":"Cureus","nlmid":"101596737"},"printPublicationDate":"2026-05-01"},"pubYear":"2026","pageInfo":"e108691","abstractText":"Clustered regularly interspaced short palindromic repeats-associated protein 9 (CRISPR-Cas9)-mediated gene editing has emerged as a pivotal advancement in hematological medicine, addressing genetic and regulatory abnormalities underlying inherited and acquired blood disorders. Conventional therapeutic strategies offer symptomatic control or partial disease modification, leaving substantial unmet clinical need for durable, mechanism-driven interventions. This narrative review aims to synthesize the translational and clinical progress of CRISPR-Cas9 applications in hematological disorders, with an emphasis on therapeutic strategies, safety considerations, and integration into clinical practice. A comprehensive literature evaluation was conducted using major biomedical databases, selecting peer-reviewed studies published between 2015 and 2025 that reported mechanistic, translational, or clinical relevance in hematology. Eligible literature included experimental investigations, clinical trials, and high-quality reviews, with exclusion of non-translational and germline-focused studies. This review highlights advances in hematopoietic stem cell editing, correction of hemoglobinopathies, immune cell engineering, and chimeric antigen receptor-based therapies, as well as progress in delivery platforms and high-fidelity nuclease designs. Key challenges related to off-target effects, genomic stability, manufacturing scalability, regulatory oversight, and ethical governance are critically evaluated. Emerging clinical trial outcomes demonstrate sustained therapeutic benefit and expanding feasibility across diverse hematological indications. Long-term clinical monitoring remains central to evaluating durability and safety. Collectively, current evidence supports CRISPR-Cas9 as a cornerstone technology in precision hematology, with continued optimization required to enable safe, equitable, and widespread clinical adoption.","affiliation":"Department of Transfusion Medicine, Uttar Pradesh University of Medical Sciences, Saifai, IND.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Hematological Disorders","Gene Editing","Precision Medicine","Crispr-cas9","Translational Applications"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.7759/cureus.108691"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13254413"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13254413?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["nct"]},"dateOfCompletion":"2026-06-15","dateOfCreation":"2026-06-15","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-05-11","firstPublicationDate":"2026-05-11","firstIndexDate":"2026-06-16","fullTextReceivedDate":"2026-06-13","hasEvaluations":"N"},{"id":"42134990","source":"MED","pmid":"42134990","pmcid":"PMC13262947","fullTextIdList":{"fullTextId":["PMC13262947"]},"doi":"10.1101/gr.280564.125","title":"Tree reconstruction guarantees from CRISPR-Cas9 lineage tracing data using Neighbor-Joining.","authorString":"An K, Prillo S, Wu W, Kristanto I, Jones MG, Song YS, Yosef N.","authorList":{"author":[{"fullName":"An K","lastName":"An","firstName":"Kevin","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Electrical Engineering and Computer Sciences, University of California, Berkeley, California 94720, USA."}]}},{"fullName":"Prillo S","lastName":"Prillo","firstName":"Sebastian","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Electrical Engineering and Computer Sciences, University of California, Berkeley, California 94720, USA."}]}},{"fullName":"Wu W","lastName":"Wu","firstName":"Wilson","initials":"W","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Electrical Engineering and Computer Sciences, University of California, Berkeley, California 94720, USA."}]}},{"fullName":"Kristanto I","lastName":"Kristanto","firstName":"Ivan","initials":"I","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Molecular and Cell Biology, University of California, Berkeley, California 94720, USA."}]}},{"fullName":"Jones MG","lastName":"Jones","firstName":"Matthew G","initials":"MG","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Personal Dynamic Regulomes, Stanford University, Stanford, California 94305, USA."}]}},{"fullName":"Song YS","lastName":"Song","firstName":"Yun S","initials":"YS","authorId":{"type":"ORCID","value":"0000-0002-0734-9868"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Electrical Engineering and Computer Sciences, University of California, Berkeley, California 94720, USA; nir.yosef@weizmann.ac.il yss@berkeley.edu."},{"affiliation":"Department of Statistics, University of California, Berkeley, California 94720, USA."}]}},{"fullName":"Yosef N","lastName":"Yosef","firstName":"Nir","initials":"N","authorId":{"type":"ORCID","value":"0000-0001-9004-1225"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Electrical Engineering and Computer Sciences, University of California, Berkeley, California 94720, USA; nir.yosef@weizmann.ac.il yss@berkeley.edu."},{"affiliation":"Department of Systems Immunology, Weizmann Institute of Science, Rehovot 7610001, Israel."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-9004-1225"},{"type":"ORCID","value":"0000-0002-0734-9868"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"6","volume":"36","journalIssueId":4205172,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Genome Res","title":"Genome research","essn":"1549-5469","issn":"1088-9051","isoabbreviation":"Genome Res","nlmid":"9518021"},"printPublicationDate":"2026-06-01"},"pubYear":"2026","pageInfo":"1199-1208","abstractText":"CRISPR-Cas9-based lineage tracing technologies have enabled the reconstruction of single-cell phylogenies from transcriptional readouts. However, developing tree-reconstruction algorithms with theoretical guarantees in this setting is challenging. In this work, we derive a reconstruction algorithm with theoretical guarantees using Neighbor-Joining (NJ) on distances that are moment-matched to estimate the true tree distances. We develop a series of tools to analyze this algorithm and prove its theoretical guarantees. When the parameters of the data generating process are known and there is no missing data, our results align with established results from common evolutionary models, such as Cavender-Farris-Neyman and Jukes-Cantor. However, to account for the realistic case where the parameters of the data generating process are not known and there is missing data, we develop new theory that shows for the first time that it is still possible to obtain reconstruction guarantees in the CRISPR-Cas9 case and in other models of evolution. Empirically, we show on both simulated lineage tracing data and on real data from a mouse model of lung cancer the improved performance of our method as compared to the traditional use of NJ.","affiliation":"Department of Electrical Engineering and Computer Sciences, University of California, Berkeley, California 94720, USA.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Journal Article","Research Support, N.I.H., Extramural"]},"grantsList":{"grant":[{"agency":"NHGRI NIH HHS","acronym":"HG","grantId":"R56 HG013117","orderIn":0},{"agency":"European Union Council","grantId":"101089213","orderIn":0},{"agency":"NCI NIH HHS","acronym":"CA","grantId":"K99 CA286968","orderIn":0},{"agency":"NHGRI NIH HHS","acronym":"HG","grantId":"R01 HG013117","orderIn":0},{"agency":"National Institutes of Health","grantId":"R56-HG013117","orderIn":0},{"agency":"National Cancer Institute of the National Institutes of Health","grantId":"K99CA286968","orderIn":0},{"agency":"National Institutes of Health","grantId":"R01-HG013117","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Mice"},{"majorTopic_YN":"N","descriptorName":"Lung Neoplasms","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Phylogeny"},{"majorTopic_YN":"Y","descriptorName":"Cell Lineage","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Algorithms"},{"majorTopic_YN":"Y","descriptorName":"CRISPR-Cas Systems"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1101/gr.280564.125"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13262947"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13262947?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":1,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"Y","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-06-03","dateOfCreation":"2026-05-14","dateOfRevision":"2026-09-27","electronicPublicationDate":"2026-06-01","firstPublicationDate":"2026-06-01","firstIndexDate":"2026-05-15","fullTextReceivedDate":"2026-06-13","hasEvaluations":"N"},{"id":"42553238","source":"MED","pmid":"42553238","pmcid":"PMC13433599","fullTextIdList":{"fullTextId":["PMC13433599"]},"doi":"10.3389/fgeed.2026.1875376","title":"CRISPR/Cas9-based gene-editing platform development by targeting genes encoding magnesium chelatase and phytoene desaturase in sugarbeet (&lt;i&gt;Beta vulgaris&lt;/i&gt; L.).","authorString":"Khan ZA, Hathaway T, Chu C, Gupta R, Bolton M, Ramachandran V.","authorList":{"author":[{"fullName":"Khan ZA","lastName":"Khan","firstName":"Zainul A","initials":"ZA","authorId":{"type":"ORCID","value":"0000-0001-8043-2839"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Oak Ridge Institute for Science and Education, United States Department of Agriculture, Agricultural Research Service, Fargo, ND, United States."},{"affiliation":"United States Department of Agriculture, Agricultural Research Service, Sugarbeet Research Unit, Edward T. Schafer Agricultural Research Center, Fargo, ND, United States."}]}},{"fullName":"Hathaway T","lastName":"Hathaway","firstName":"Tinley","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"United States Department of Agriculture, Agricultural Research Service, Sugarbeet Research Unit, Edward T. Schafer Agricultural Research Center, Fargo, ND, United States."},{"affiliation":"Department of Plant Pathology, Microbiology and Biotechnology, North Dakota State University, Fargo, ND, United States."}]}},{"fullName":"Chu C","lastName":"Chu","firstName":"Chenggen","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"United States Department of Agriculture, Agricultural Research Service, Sugarbeet Research Unit, Edward T. Schafer Agricultural Research Center, Fargo, ND, United States."}]}},{"fullName":"Gupta R","lastName":"Gupta","firstName":"Rajeev","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"United States Department of Agriculture, Agricultural Research Service, Cereal Crops Improvement Research Unit, Edward T. Schafer Agricultural Research Center, Fargo, ND, United States."}]}},{"fullName":"Bolton M","lastName":"Bolton","firstName":"Melvin","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"United States Department of Agriculture, Agricultural Research Service, Sugarbeet Research Unit, Edward T. Schafer Agricultural Research Center, Fargo, ND, United States."}]}},{"fullName":"Ramachandran V","lastName":"Ramachandran","firstName":"Vanitharani","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"United States Department of Agriculture, Agricultural Research Service, Sugarbeet Research Unit, Edward T. Schafer Agricultural Research Center, Fargo, ND, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8043-2839"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"8","journalIssueId":4145489,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Front Genome Ed","title":"Frontiers in genome editing","essn":"2673-3439","issn":"2673-3439","isoabbreviation":"Front Genome Ed","nlmid":"101775540"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"1875376","abstractText":"Sugarbeet (<i>Beta vulgaris</i> ssp. <i>vulgaris</i>, L.), is a vital temperate crop, supplying nearly 40% of the world's sugar. However, its high susceptibility to bacterial, fungal, and viral diseases creates an urgent need for improved, disease-resistant cultivars. The CRISPR/Cas9 system has rapidly advanced plant genetic engineering by enabling precise and targeted genome modifications. Our goal is to establish a gene-editing platform in sugarbeet to support future development of disease-resistant lines by targeting the candidate genes. In this study, we applied CRISPR/Cas9 to generate targeted mutations in two genes involved in chlorophyll biosynthesis and carotenoid-mediated leaf pigmentation: <i>magnesium chelatase</i> (Mg-chelatase) and <i>phytoene desaturase</i> (PDS). Two CRISPR/Cas9 constructs, each carrying an sgRNA targeting either Mg-chelatase or PDS, were developed and mobilized into <i>Agrobacterium tumefaciens</i>. A total of 233 and 200 hypocotyl explants were transformed with constructs targeting Mg-chelatase and PDS, resulting in regeneration efficiencies of 8% and 14% on kanamycin selection medium, respectively. Light green, yellow, variegated yellow-green, and albino phenotypes were observed among the putative transformants, whereas non-edited transformed lines resembled untransformed control plants. Targeted mutations, including insertions, deletions, and substitutions of nucleotides, were identified at both genomic loci, with editing efficiencies of 60.0% for Mg-chelatase and 68.75% for PDS underscoring the effectiveness of this approach in sugarbeet, a recalcitrant crop. Deletions ranged from 5 to 28 bp in Mg-chelatase and 2 to 21 bp in PDS, while insertion events consisted of single-base additions in Mg-chelatase edited lines and larger insertions of 7-16 bp in PDS mutants. The results demonstrate the successful deployment of CRISPR/Cas9 for targeted genome engineering in sugarbeet and establish a reliable platform for future gene-editing efforts aimed at enhancing resistance to a wide range of pathogens and diseases affecting the crop.","affiliation":"The Oak Ridge Institute for Science and Education, United States Department of Agriculture, Agricultural Research Service, Fargo, ND, United States.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Beta vulgaris","Sugarbeet","Phytoene desaturase","Magnesium Chelatase","Gene-editing"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fgeed.2026.1875376"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13433599"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13433599?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":1,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["gen","refseq"]},"dateOfCompletion":"2026-08-05","dateOfCreation":"2026-08-05","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-07-21","firstPublicationDate":"2026-07-21","firstIndexDate":"2026-08-05","fullTextReceivedDate":"2026-09-04","hasEvaluations":"N"},{"id":"42028170","source":"MED","pmid":"42028170","pmcid":"PMC13100679","fullTextIdList":{"fullTextId":["PMC13100679"]},"doi":"10.1016/j.omtn.2026.102859","title":"CRISPR-Cas9-mediated therapeutics: Current clinical trials and therapy approval landscape to treat human diseases.","authorString":"Chakraborty C, Bhattacharya M, Das A, Agoramoorthy G, Lee SS.","authorList":{"author":[{"fullName":"Chakraborty C","lastName":"Chakraborty","firstName":"Chiranjib","initials":"C","authorId":{"type":"ORCID","value":"0000-0002-3958-239X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biotechnology, School of Life Science and Biotechnology, Adamas University, Kolkata, West Bengal 700126, India."},{"affiliation":"Centre of Excellence for Advanced Medical Bioinformatics and Artificial Intelligence, Adamas University, Kolkata, West Bengal 700126, India."}]}},{"fullName":"Bhattacharya M","lastName":"Bhattacharya","firstName":"Manojit","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Zoology, Fakir Mohan University, Vyasa Vihar, Balasore, Odisha 756020, India."}]}},{"fullName":"Das A","lastName":"Das","firstName":"Arpita","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Health and Social Care, QA Higher Education, West Midlands, UK."}]}},{"fullName":"Agoramoorthy G","lastName":"Agoramoorthy","firstName":"Govindasamy","initials":"G","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Pharmacy and Health Care, Tajen University, Yanpu, Pingtung 907, Taiwan."},{"affiliation":"Honeybee Population Health Foundation, Chennai, India."}]}},{"fullName":"Lee SS","lastName":"Lee","firstName":"Sang-Soo","initials":"SS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute for Skeletal Aging & Orthopedic Surgery, Hallym University-Chuncheon Sacred Heart Hospital, Chuncheon, Gangwon-Do 24252, Republic of Korea."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-3958-239X"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"37","journalIssueId":4080165,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Mol Ther Nucleic Acids","title":"Molecular therapy. Nucleic acids","essn":"2162-2531","issn":"2162-2531","isoabbreviation":"Mol Ther Nucleic Acids","nlmid":"101581621"},"printPublicationDate":"2026-03-01"},"pubYear":"2026","pageInfo":"102859","abstractText":"The genome editing technology using CRISPR-Cas9 has created a new trajectory for treating diverse human diseases. The approval of CRISPR-Cas9 therapeutics was first given to Casgevy for treating transfusion-dependent β-thalassemia (TDT) by the UK Medicines and Healthcare Products Regulatory Agency (UKMHRA) on November 16, 2023. Subsequently, UKMHRA approved Casgevy for the treatment of sickle cell disease (SCD), which was approved by the US Food and Drug Administration (FDA) on December 8, 2023. The approval has created a new era of gene editing medicine. Numerous clinical trials have been initiated to treat different human diseases. In this comprehensive review, we present an overview of the therapeutic development that includes the earliest days of research using CRISPR-Cas9 technology, clinical trials, UKMHRA/FDA-approved therapeutics (Casgevy), and the CRISPR-Cas9 technology approved for the therapy of SCD and TDT. We also present details on the role of biopharmaceutical industry-academia collaboration and patent landscape of the CRISPR-Cas9 technology. Finally, the therapeutics' challenges, safety concerns, and cost-effectiveness are illustrated to provide a complete understanding on the current landscape of CRISPR-Cas9-mediated therapeutics for countries' policymakers, biopharmaceutical companies, and next-generation researchers to formulate the future strategies.","affiliation":"Department of Biotechnology, School of Life Science and Biotechnology, Adamas University, Kolkata, West Bengal 700126, India.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"agency":"National Research Foundation of Korea","orderIn":0},{"agency":"Ministry of Education","grantId":"- 2020R1I1A3074575","orderIn":0}]},"keywordList":{"keyword":["Therapeutics","Clinical Trial","Gene Editing","Crispr-cas9","Mt: Oligonucleotides: Therapies