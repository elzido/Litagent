thorAffiliation":[{"affiliation":"Department of Microbiology and Immunology, The University of Melbourne, at the Peter Doherty Institute for Infection and Immunity, Victoria 3000, Australia."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-4300-455X"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"3","volume":"8","journalIssueId":4222563,"dateOfPublication":"2026 Sep","monthOfPublication":9,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"NAR Genom Bioinform","title":"NAR genomics and bioinformatics","essn":"2631-9268","issn":"2631-9268","isoabbreviation":"NAR Genom Bioinform","nlmid":"101756213"},"printPublicationDate":"2026-09-01"},"pubYear":"2026","pageInfo":"lqag111","abstractText":"One of the main challenges of whole transcriptome sequencing is the difficulty in detecting and quantifying low-to-moderate abundance transcripts. Methods that address this are either complicated to scale or customize; long-range PCR is problematic to scale, and probe hybridization panels are expensive to customize. In this study, we developed an RNA-guided CRISPR-Cas9 nuclease-based enrichment strategy combined with long-read sequencing, which achieved up to 60-fold enrichment of the target. Our findings demonstrate that the CRISPR-Cas system is a highly effective method for customizable long-read sequencing of target transcripts, which preserves estimation of relative abundance.","affiliation":"Department of Microbiology and Immunology, The University of Melbourne, at the Peter Doherty Institute for Infection and Immunity, Victoria 3000, Australia.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Protein Isoforms","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","quali