ationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, Feinberg School of Medicine, Northwestern University, Chicago, IL, 60611, USA."}]}},{"fullName":"Vincent A","lastName":"Vincent","firstName":"Andrew","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, Feinberg School of Medicine, Northwestern University, Chicago, IL, 60611, USA."}]}},{"fullName":"Soto-Echevarria N","lastName":"Soto-Echevarria","firstName":"Nashaly","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, Feinberg School of Medicine, Northwestern University, Chicago, IL, 60611, USA."},{"affiliation":"Department of Molecular Biology, Princeton University, Princeton, NJ, 08544, USA."}]}},{"fullName":"Wray B","lastName":"Wray","firstName":"Brian","initials":"B","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Louis A Simpson and Kimberly K Querrey Biomedical Research Center, Northwestern University, Chicago, IL, 60611, USA."}]}},{"fullName":"Bartom ET","lastName":"Bartom","firstName":"Elizabeth T","initials":"ET","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Louis A Simpson and Kimberly K Querrey Biomedical Research Center, Northwestern University, Chicago, IL, 60611, USA."}]}},{"fullName":"Paunesku T","lastName":"Paunesku","firstName":"Tatjana","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, Feinberg School of Medicine, Northwestern University, Chicago, IL, 60611, USA."}]}},{"fullName":"Goodman CR","lastName":"Goodman","firstName":"Chelain R","initials":"CR","authorId":{"type":"ORCID","value":"0000-0001-9083-3652"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, Feinberg School of Medicine, Northwestern University, Chicago, IL, 60611, USA."},{"affiliation":"Department of Breast Radiation Oncology, Division of Radiation Oncology, MD Anderson Cancer Center, The University of Texas, Houston, 77030, TX, USA."}]}},{"fullName":"Woloschak GE","lastName":"Woloschak","firstName":"Gayle E","initials":"GE","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, Feinberg School of Medicine, Northwestern University, Chicago, IL, 60611, USA. g-woloschak@northwestern.edu."},{"affiliation":"Departments of Radiation Oncology, Radiology, and Cell and Molecular Biology, Robert H. Lurie Comprehensive Cancer Center, Feinberg School of Medicine, Northwestern University, Chicago, IL, 60611, USA. g-woloschak@northwestern.edu."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-7942-6490"},{"type":"ORCID","value":"0000-0001-9083-3652"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data","related_data"]},"journalInfo":{"issue":"1","volume":"16","journalIssueId":4082835,"dateOfPublication":"2026 Jan","monthOfPublication":1,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Sci Rep","title":"Scientific reports","essn":"2045-2322","issn":"2045-2322","isoabbreviation":"Sci Rep","nlmid":"101563288"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"6797","abstractText":"Elevated Epidermal Growth Factor Receptor (EGFR) expression is observed in most cervical cancers, and it is frequently associated with poor clinical outcomes. The limited efficacy of existing EGFR-targeted therapies in cervical cancer highlights the need for a deeper understanding of EGFR role in this cancer type. To investigate EGFR separately from its interaction with Epidermal Growth Factor (EGF), we removed the key amino acids from the ligand bindings site. We used CRISPR/Cas9 genome editing to generate a panel of EGFR mutant cell lines and then sequenced and characterized them in detail. Studying the phenotypes of mutant cell clones, we show that a pair of amino acid substitutions L14R and Y45M within Domain I of EGFR protein completely disrupts EGF binding and changes EGFR subcellular distribution. A single substitution Y45M significantly reduced EGF binding but did not lead to subcellular redistribution of EGFR. Upon editing, EGFR mRNA and protein expression were decreased in mutant clones compared to wild type cells. Genome wide profiling of different CRISPR/Cas9 clones confirmed correct editing of EGFR with no off target CRISPR/Cas9 generated mutations. At the same time, spontaneous mutations that could impact cell phenotypes were detected in mutant clones. Disruption of ligand binding domain of EGFR by sequential knock in CRISPR/Cas9 genome editing altered subcellular localization and phosphorylation of EGFR in cervical cancer cells. The results presented here provide insights that may accelerate the development of CRISPR/Cas9-based therapies for EGFR-dependent cancers and reinforce the importance of thorough evaluation of CRISPR/Cas9-generated phenotypes.","affiliation":"Department of Radiation Oncology, Feinberg School of Medicine, Northwestern University, Chicago, IL, 60611, USA.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"agency":"National Institutes of Health","grantId":"CA221848-07","orderIn":0},{"agency":"Brinson Foundation","orderIn":0},{"agency":"NCI NIH HHS","acronym":"CA","grantId":"R50 CA221848","orderIn":0},{"agency":"NIH HHS","acronym":"NH","grantId":"CA221848-07","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Cell Line, Tumor"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Epidermal Growth Factor","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"N","descriptorName":"Amino Acid Substitution"},{"majorTopic_YN":"N","descriptorName":"Binding Sites"},