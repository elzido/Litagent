n":"Institute for Molecular Medicine Finland and Helsinki Institute of Life Science, University of Helsinki, Helsinki, Finland."}]}},{"fullName":"Schalin-Jäntti C","lastName":"Schalin-Jäntti","firstName":"Camilla","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Endocrinology, Abdominal Center, Helsinki University Hospital, Helsinki, Finland."},{"affiliation":"University of Helsinki, ENDO-ERN (European Reference Network on Rare Endocrine Conditions), Helsinki, Finland."}]}},{"fullName":"Leinonen E","lastName":"Leinonen","firstName":"Eira","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Folkhälsan Institute of Genetics, and Stem Cells and Metabolism Research Program, University of Helsinki, Helsinki, Finland."}]}},{"fullName":"Fevang B","lastName":"Fevang","firstName":"Børre","initials":"B","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Clinical Medicine, University of Oslo, Oslo, Norway."},{"affiliation":"Section of Clinical Immunology and Infectious Diseases, Oslo University Hospital, Rikshospitalet, Oslo, Norway."}]}},{"fullName":"Grönholm J","lastName":"Grönholm","firstName":"Juha","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Translational Immunology Research Program, University of Helsinki, Helsinki, Finland."},{"affiliation":"Pediatric Research Center, New Children's Hospital, University of Helsinki and HUS Helsinki University Hospital, Helsinki, Finland."},{"affiliation":"Division of Hematology, Oncology, and Stem Cell Transplantation, New Children's Hospital, HUS Helsinki University Hospital, Helsinki, Finland."}]}},{"fullName":"Martelius T","lastName":"Martelius","firstName":"Timi","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Inflammation Center, Department of Infectious Disease, Helsinki University Hospital and University of Helsinki, Helsinki, Finland."}]}},{"fullName":"Dahal-Koirala S","lastName":"Dahal-Koirala","firstName":"Shiva","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Norwegian Centre for Molecular Biosciences and Medicine, University of Oslo, Oslo, Norway."},{"affiliation":"Precision Immunotherapy Alliance, University of Oslo, Oslo, Norway."}]}},{"fullName":"Haapaniemi EM","lastName":"Haapaniemi","firstName":"Emma Maria","initials":"EM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Norwegian Centre for Molecular Biosciences and Medicine, University of Oslo, Oslo, Norway."},{"affiliation":"Department of Pediatrics, Oslo University Hospital, Oslo, Norway."},{"affiliation":"Precision Immunotherapy Alliance, University of Oslo, Oslo, Norway."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-4573-3297"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"8","journalIssueId":4145489,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Front Genome Ed","title":"Frontiers in genome editing","essn":"2673-3439","issn":"2673-3439","isoabbreviation":"Front Genome Ed","nlmid":"101775540"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"1817322","abstractText":"CRISPR/Cas9 enables precision gene editing via homology-directed repair (HDR) for mutation correction and disease modelling. Here we present a customizable T cell single nucleotide variant (SNV) correction platform based on non-viral HDR, previously described in Mamia et al. <i>Precision T Cell Correction Platform for Inborn Errors of Immunity</i>. Molecular Therapy, 2025. To enable reproducible application, we provide a comprehensive, step-by-step 8-day HDR workflow for editing primary T cells, covering CRISPR/Cas9 reagent design, custom genomic editing from start to finish, optimization and validation strategies, on-target detection, and flow cytometric assessment of T cell phenotype and exhaustion. The platform separates locus-specific reagent optimization from a fixed cellular workflow, enabling implementation of new genomic targets without modifying the downstream T cell editing pipeline. Using this workflow, we have achieved up to 80% editing efficiency across multiple loci and donors. We have further optimized the T cell culture platform for PBMC stimulation to promote CD4<sup>+</sup> and CD8<sup>+</sup> T cell activation and proliferation. We validated this culture platform in 33 patients with Inborn Errors of Immunity using flow cytometry and observed that the defined culture conditions maintain low T cell exhaustion and support persistence of memory T cell populations. The protocol was developed under research-grade conditions but supports scalability and transition to preclinical and clinical GMP workflows. Overall, this adaptable platform is a broadly applicable framework for precision T cell engineering across diverse genomic targets offering opportunities for both <i>in vitro</i> disease modeling and therapeutic genome correction.","affiliation":"Norwegian Centre for Molecular Biosciences and Medicine, University of Oslo, Oslo, Norway.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["methods-article","Journal Article"]},"keywordList":{"keyword":["T cells","Genome Editing","Crispr/cas9","Homology Directed Repair (Hdr)","Inborn Errors Of Immunity (Iei)"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fgeed.2026.1817322"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13696951"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13696951?pdf=render"}]},"commentCorrectionList":{"commentCorrection":[