availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13122305?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"Y","hasData":"Y","license":"cc by-nc","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-23","dateOfCreation":"2026-04-21","dateOfRevision":"2026-09-26","electronicPublicationDate":"2026-04-20","firstPublicationDate":"2026-04-20","firstIndexDate":"2026-04-22","fullTextReceivedDate":"2026-05-18","hasEvaluations":"N"},{"id":"41503845","source":"MED","pmid":"41503845","pmcid":"PMC12780971","fullTextIdList":{"fullTextId":["PMC12780971"]},"doi":"10.1111/jcmm.70986","title":"Disrupting Viral Persistence: CRISPR/Cas9-Based Strategies for Hepatitis B and C Treatment, and Challenges.","authorString":"Li MF, Zubair A, Wdidi S, He S.","authorList":{"author":[{"fullName":"Li MF","lastName":"Li","firstName":"Meng-Fan","initials":"MF","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Food Science School, Guangdong Pharmaceutical University, Zhongshan, China."}]}},{"fullName":"Zubair A","lastName":"Zubair","firstName":"Akmal","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biotechnology, Quaid-i-Azam University, Islamabad, Pakistan."}]}},{"fullName":"Wdidi S","lastName":"Wdidi","firstName":"Safa","initials":"S","authorId":{"type":"ORCID","value":"0009-0002-0201-8880"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Medical Sciences Laboratory, Oncology Research Center, University of Shendi, Shendi, Sudan."}]}},{"fullName":"He S","lastName":"He","firstName":"Shan","initials":"S","authorId":{"type":"ORCID","value":"0000-0002-2698-0786"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Science, Technology and Engineering, Charles Darwin University, Casuarina, Northwest Territories, Australia."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2698-0786"},{"type":"ORCID","value":"0009-0002-0201-8880"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"30","journalIssueId":4080528,"dateOfPublication":"2026 Jan","monthOfPublication":1,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"J Cell Mol Med","title":"Journal of cellular and molecular medicine","essn":"1582-4934","issn":"1582-1838","isoabbreviation":"J Cell Mol Med","nlmid":"101083777"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"e70986","abstractText":"Hepatitis B and C viruses (HBV and HCV) remain among the leading causes of liver disease worldwide. Current antiviral drugs, such as nucleotide analogues (NAs), can reduce the replication of new HBV and HCV infections but cannot completely eliminate chronic infections. This is primarily because a stable form of viral DNA, known as covalently closed circular DNA (cccDNA), persists in liver cells and continues to sustain the infection. In recent years, the CRISPR/Cas9 gene-editing system has emerged as a powerful tool for precisely cutting and inactivating specific DNA sequences. Due to its efficiency and ease of use, researchers have applied CRISPR/Cas9 in numerous studies to directly target and disrupt the HBV genome, demonstrating promising antiviral effects in both cell cultures and animal models. Targeting multiple sites within the HBV genome has been shown to further enhance its effectiveness, paving the way for potential combination therapies aimed at disabling both cccDNA and HBV and HCV DNA integrated into the host genome. Despite its potential, CRISPR/Cas9 still faces significant challenges before clinical application, most notably the risk of off-target effects-unintended cleavage of non-target DNA sequences-and the difficulty of delivering the system efficiently into liver cells in vivo. Future progress will depend on improving the tool's precision, efficiency, flexibility and delivery methods. In this review, we explore recent advances in designing guide RNAs (gRNAs) for targeting HBV and HCV, as well as the delivery systems used to transport CRISPR/Cas9 into cells. We also discuss the remaining challenges and potential strategies for advancing CRISPR/Cas9 from the laboratory toward a viable clinical cure for HBV and HCV.","affiliation":"Food Science School, Guangdong Pharmaceutical University, Zhongshan, China.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Hepatitis B virus","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Hepacivirus","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Hepatitis B","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"TH","qualifierName":"therapy"},{"majorTopic_YN":"N","abbreviation":"VI","qualifierName":"virology"}]}},{"majorTopic_YN":"Y","descriptorName":"Hepatitis C","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"TH","qualifierName":"therapy"},{"majorTopic_YN":"N","abbreviation":"VI","qualifierName":"virology"}]}},{"majorTopic_YN":"N","descriptorName":"DNA, Circular","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majo