uthorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, University of Cambridge, Hills Road, Cambridge, CB2 0QQ, UK."},{"affiliation":"Cambridge Institute for Therapeutic Immunology and Infectious Disease (CITIID), University of Cambridge, Puddicombe Way, Cambridge, CB2 0AW, UK."}]}},{"fullName":"Gerber PP","lastName":"Gerber","firstName":"Pehuén Pereyra","initials":"PP","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, University of Cambridge, Hills Road, Cambridge, CB2 0QQ, UK."},{"affiliation":"Cambridge Institute for Therapeutic Immunology and Infectious Disease (CITIID), University of Cambridge, Puddicombe Way, Cambridge, CB2 0AW, UK."}]}},{"fullName":"Wit N","lastName":"Wit","firstName":"Niek","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, University of Cambridge, Hills Road, Cambridge, CB2 0QQ, UK."},{"affiliation":"Cambridge Institute for Therapeutic Immunology and Infectious Disease (CITIID), University of Cambridge, Puddicombe Way, Cambridge, CB2 0AW, UK."}]}},{"fullName":"Nathan JA","lastName":"Nathan","firstName":"James A","initials":"JA","authorId":{"type":"ORCID","value":"0000-0002-0248-1632"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, University of Cambridge, Hills Road, Cambridge, CB2 0QQ, UK."},{"affiliation":"Cambridge Institute for Therapeutic Immunology and Infectious Disease (CITIID), University of Cambridge, Puddicombe Way, Cambridge, CB2 0AW, UK."}]}},{"fullName":"Matheson NJ","lastName":"Matheson","firstName":"Nicholas J","initials":"NJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, University of Cambridge, Hills Road, Cambridge, CB2 0QQ, UK."},{"affiliation":"Cambridge Institute for Therapeutic Immunology and Infectious Disease (CITIID), University of Cambridge, Puddicombe Way, Cambridge, CB2 0AW, UK."},{"affiliation":"NHS Blood and Transplant, Cambridge, UK."}]}},{"fullName":"Lehner PJ","lastName":"Lehner","firstName":"Paul J","initials":"PJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine, University of Cambridge, Hills Road, Cambridge, CB2 0QQ, UK. pjl30@cam.ac.uk."},{"affiliation":"Cambridge Institute for Therapeutic Immunology and Infectious Disease (CITIID), University of Cambridge, Puddicombe Way, Cambridge, CB2 0AW, UK. pjl30@cam.ac.uk."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-0248-1632"},{"type":"ORCID","value":"0009-0005-8142-7966"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"1","volume":"15","journalIssueId":3920966,"dateOfPublication":"2025 Apr","monthOfPublication":4,"yearOfPublication":2025,"journal":{"medlineAbbreviation":"Sci Rep","title":"Scientific reports","essn":"2045-2322","issn":"2045-2322","nlmid":"101563288","isoabbreviation":"Sci Rep"},"printPublicationDate":"2025-04-01"},"pubYear":"2025","pageInfo":"11907","abstractText":"The TMPRSS2 cell surface protease is used by a broad range of respiratory viruses to facilitate entry into target cells. Together with ACE2, TMPRSS2 represents a key factor for SARS-CoV-2 infection, as TMPRSS2 mediates cleavage of viral spike protein, enabling direct fusion of the viral envelope with the host cell membrane. Since the start of the COVID-19 pandemic, TMPRSS2 has gained attention as a therapeutic target for protease inhibitors which would inhibit SARS-CoV-2 infection, but little is known about TMPRSS2 regulation, particularly in cell types physiologically relevant for SARS-CoV-2 infection. Here, we performed an unbiased genome-wide CRISPR-Cas9 library screen, together with a library targeted at epigenetic modifiers and transcriptional regulators, to identify cellular factors that modulate cell surface expression of TMPRSS2 in human colon epithelial cells. We find that endogenous TMPRSS2 is regulated by the Elongin BC-VHL complex and HIF transcription factors. Depletion of Elongin B or treatment of cells with PHD inhibitors resulted in downregulation of TMPRSS2 and inhibition of SARS-CoV-2 infection. We show that TMPRSS2 is still utilised by SARS-CoV-2 Omicron variants for entry into colonic epithelial cells. Our study enhances our understanding of the regulation of endogenous surface TMPRSS2 in cells physiologically relevant to SARS-CoV-2 infection.","affiliation":"Department of Medicine, University of Cambridge, Hills Road, Cambridge, CB2 0QQ, UK.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"agency":"Medical Research Council","acronym":"MRC_","grantId":"MR/V011561/1","orderIn":0},{"agency":"Wellcome Trust","grantId":"227418/Z/23/Z","orderIn":0},{"agency":"Wellcome Trust","acronym":"WT_","grantId":"227418","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Serine Endopeptidases","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"Y","descriptorName":"CRISPR-Cas Systems"},{"majorTopic_YN":"N","descriptorName":"COVID-19","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"},{"majorTopic_YN":"N","abbreviation":"VI","qualifierName":"virology"}]}},{"majorTopic_YN":"N","descriptorName":"SARS-CoV-2"}]},"keywordList":{"keyword":["Colon Epithelial Cells","Crispr-cas9 Screen","Transmembrane Serine Proteases","Coronavirus Entry Factors","Hypoxic Regulation Of Surface Proteins"]},"chemicalList":{"chemical":[{"name":"TMPRSS2 protein, human","registryNumber":"EC 3.4.21.-"},{"name":"Serine Endopeptidas