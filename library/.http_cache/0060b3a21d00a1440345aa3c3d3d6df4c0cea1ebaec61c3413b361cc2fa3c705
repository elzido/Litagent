hMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2024-08-23","dateOfCreation":"2024-08-23","dateOfRevision":"2026-09-22","electronicPublicationDate":"2024-08-23","firstPublicationDate":"2024-08-23","firstIndexDate":"2024-08-27","fullTextReceivedDate":"2025-02-04","hasEvaluations":"N"},{"id":"42463755","source":"MED","pmid":"42463755","pmcid":"PMC13376781","fullTextIdList":{"fullTextId":["PMC13376781"]},"doi":"10.1038/s41598-026-59276-2","title":"CRISPR-Cas9 mediated knockout of the white gene in the bluetongue virus vector, Culicoides sonorensis (biting midge).","authorString":"Nevard K, Gonzalez E, Harvey-Samuel T, Sanders C, Homem RA.","authorList":{"author":[{"fullName":"Nevard K","lastName":"Nevard","firstName":"Katherine","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Pirbright Institute, Ash Road, Pirbright, GU24 0NF, Surrey, UK."}]}},{"fullName":"Gonzalez E","lastName":"Gonzalez","firstName":"Estela","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Pirbright Institute, Ash Road, Pirbright, GU24 0NF, Surrey, UK."},{"affiliation":"The Animal and Plant Health Agency, Woodham Lane, Addlestone, Surrey, KT15 3NB, UK."}]}},{"fullName":"Harvey-Samuel T","lastName":"Harvey-Samuel","firstName":"Tim","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Pirbright Institute, Ash Road, Pirbright, GU24 0NF, Surrey, UK."},{"affiliation":"Keele University, Keele, Newcastle, ST5 5BG, UK."}]}},{"fullName":"Sanders C","lastName":"Sanders","firstName":"Christopher","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Pirbright Institute, Ash Road, Pirbright, GU24 0NF, Surrey, UK."}]}},{"fullName":"Homem RA","lastName":"Homem","firstName":"Rafael A","initials":"RA","authorId":{"type":"ORCID","value":"0000-0001-9649-1825"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Pirbright Institute, Ash Road, Pirbright, GU24 0NF, Surrey, UK. rafael.homem@pirbright.ac.uk."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-9649-1825"},{"type":"ORCID","value":"0000-0002-4296-0080"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"16","journalIssueId":4223254,"dateOfPublication":"2026 Jul","monthOfPublication":7,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Sci Rep","title":"Scientific reports","essn":"2045-2322","issn":"2045-2322","nlmid":"101563288","isoabbreviation":"Sci Rep"},"printPublicationDate":"2026-07-01"},"pubYear":"2026","pageInfo":"19937","abstractText":"Culicoides biting midges are small blood feeding insects responsible for the transmission of important arthropod-borne viruses (arboviruses) such as bluetongue virus (BTV), Schmallenberg virus (SBV) and epizootic hemorrhagic disease virus (EHDV), which cause major losses to livestock production worldwide. Culicoides sonorensis is the primary vector of BTV in North America and one of the few Culicoides species to be colonised and reared in artificial conditions. Gene editing technology has been used to explore virus-vector interactions in other vector groups, particularly within mosquitoes. Despite the availability of a reference genome since 2018, to date there have been no reports of gene editing in C. sonorensis. Here, we report the first instance of gene editing in C. sonorensis, achieved by intrathoracic injection of adult females with Cas9 and sgRNAs targeting the white gene. We generated heritable mutations in the white gene which produced both white eye and red eye phenotypes and went on to establish a homozygous knockout line carrying a single mutation. We observed gene editing efficiencies of up to 12.3%, making this an efficient protocol for genetic manipulation of Culicoides biting midges, opening the door to functional genomics studies and the development of 