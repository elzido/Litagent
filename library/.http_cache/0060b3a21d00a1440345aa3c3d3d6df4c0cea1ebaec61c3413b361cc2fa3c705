nt Proteins","registryNumber":"147336-22-9"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1186/s12870-025-07429-2"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12821853"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12821853?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":1,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"Y","hasData":"Y","license":"cc by-nc-nd","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-01-21","dateOfCreation":"2025-12-12","dateOfRevision":"2026-01-23","electronicPublicationDate":"2025-12-13","firstPublicationDate":"2025-12-13","firstIndexDate":"2025-12-14","fullTextReceivedDate":"2026-01-22","hasEvaluations":"N"},{"id":"40995763","source":"MED","pmid":"40995763","pmcid":"PMC12461677","fullTextIdList":{"fullTextId":["PMC12461677"]},"doi":"10.1002/cpz1.70210","title":"CRISPR/Cas9-Mediated Gene Knockout in Cereal Crops.","authorString":"Pramanik D, Wang K, Lee K.","authorList":{"author":[{"fullName":"Pramanik D","lastName":"Pramanik","firstName":"Dibyajyoti","initials":"D","authorId":{"type":"ORCID","value":"0000-0002-7996-1124"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Agronomy, Iowa State University, Ames, Iowa."},{"affiliation":"Crop Bioengineering Center, Iowa State University, Ames, Iowa."}]}},{"fullName":"Wang K","lastName":"Wang","firstName":"Kan","initials":"K","authorId":{"type":"ORCID","value":"0000-0003-2474-5800"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Agronomy, Iowa State University, Ames, Iowa."},{"affiliation":"Crop Bioengineering Center, Iowa State University, Ames, Iowa."}]}},{"fullName":"Lee K","lastName":"Lee","firstName":"Keunsub","initials":"K","authorId":{"type":"ORCID","value":"0000-0002-3174-2475"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Agronomy, Iowa State University, Ames, Iowa."},{"affiliation":"Crop Bioengineering Center, Iowa State University, Ames, Iowa."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-3174-2475"},{"type":"ORCID","value":"0000-0002-7996-1124"},{"type":"ORCID","value":"0000-0003-2474-5800"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"9","volume":"5","journalIssueId":4009335,"dateOfPublication":"2025 Sep","monthOfPublication":9,"yearOfPublication":2025,"journal":{"medlineAbbreviation":"Curr Protoc","title":"Current protocols","essn":"2691-1299","issn":"2691-1299","nlmid":"101773894","isoabbreviation":"Curr Protoc"},"printPublicationDate":"2025-09-01"},"pubYear":"2025","pageInfo":"e70210","abstractText":"High-precision genome editing tools, such as programmable nucleases, are poised to transform crop breeding and significantly impact fundamental plant research. Among these tools, the CRISPR (Clustered Regularly Interspaced Short Palindromic Repeats)/Cas9 (CRISPR-associated 9) system is a programmable, RNA-guided nuclease that introduces targeted, site-specific double-stranded breaks in the target DNA loci. When these breaks are repaired, it often results in a frame-shift mutation via short insertion/deletion (indel), leading to gene knockout. Since its first successful use in plants, CRISPR/Cas9 has been widely adopted for targeting genes of agronomic and scientific importance in multiple crops, including rice, maize, wheat, and sorghum. These cereal crops ensure global food security, provide essential nutrition, and support economic stability. Additionally, such crops support biofuel production, livestock feed, and sustainable farming practices through crop rotation. This article outlines the strategies for implementing CRISPR/Cas9 genome editing in plants, including a step-by-step process of guide RNA target selection, oligonucleotide design, construct development, assembly, and analysis of genome edits. © 2025 The Author(s). Current Protocols published by Wiley Periodicals LLC. Basic Protocol 1: CRISPR/Cas9 guide RNA target selection Support Protocol 1: Genomic DNA extraction in-house protocol Basic Protocol 2: Construction of a binary plasmid vector Support Protocol 2: Agrobacterium transformation with a binary vector construct and stability check Support Protocol 3: Plant transformation Basic Protocol 3: Genotyping of edited events.","affiliation":"Department of Agronomy, Iowa State University, Ames, Iowa.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["other","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Plants, Genetically Modified","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Crops, Agricultural","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Genome, Plant"},{"majorTopic_YN":"Y","descriptorName":"Gene Knockout Techniques","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}},{"majorTopic_YN":"Y","descriptorName":"CRISPR-Cas Systems","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Edible Grain","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Gene Editing","meshQualifierList":