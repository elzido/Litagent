name":"Endopeptidases","registryNumber":"EC 3.4.-"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1007/s00253-026-13749-6"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12948783"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12948783?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":2,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"Y","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-07-09","dateOfCreation":"2026-02-26","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-02-26","firstPublicationDate":"2026-02-26","firstIndexDate":"2026-02-27","fullTextReceivedDate":"2026-09-25","hasEvaluations":"N"},{"id":"41927937","source":"MED","pmid":"41927937","doi":"10.1007/s11248-026-00490-z","title":"CRISPR/Cas9-mediated knockout of PsLykX gene of pea (Pisum sativum L.) leads to loss of symbiotic nodules.","authorString":"Zhuravlev IY, Lyakhovets AA, Matveenko AG, Lebedeva MA, Zhernakov AI, Simonova VY, Sulima AS, Tikhonovich IA, Zhukov VA.","authorList":{"author":[{"fullName":"Zhuravlev IY","lastName":"Zhuravlev","firstName":"Igor Yu","initials":"IY","authorId":{"type":"ORCID","value":"0009-0005-5967-5664"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Genetics and Life Science, Sirius University of Science and Technology, Sochi, Russia, 354340. zhuravlev.iy@talantiuspeh.ru."}]}},{"fullName":"Lyakhovets AA","lastName":"Lyakhovets","firstName":"Anton A","initials":"AA","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Genetics and Life Science, Sirius University of Science and Technology, Sochi, Russia, 354340."}]}},{"fullName":"Matveenko AG","lastName":"Matveenko","firstName":"Andrew G","initials":"AG","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Genetics and Life Science, Sirius University of Science and Technology, Sochi, Russia, 354340."},{"affiliation":"Faculty of Biology, St. Petersburg State University, Saint-Petersburg, Russia."}]}},{"fullName":"Lebedeva MA","lastName":"Lebedeva","firstName":"Maria A","initials":"MA","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Genetics and Life Science, Sirius University of Science and Technology, Sochi, Russia, 354340."},{"affiliation":"Faculty of Biology, St. Petersburg State University, Saint-Petersburg, Russia."}]}},{"fullName":"Zhernakov AI","lastName":"Zhernakov","firstName":"Aleksandr I","initials":"AI","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"All-Russia Research Institute for Agricultural Microbiology (ARRIAM), St. Petersburg, Pushkin, Russia, 196608."}]}},{"fullName":"Simonova VY","lastName":"Simonova","firstName":"Veronika Y","initials":"VY","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Genetics and Life Science, Sirius University of Science and Technology, Sochi, Russia, 354340."}]}},{"fullName":"Sulima AS","lastName":"Sulima","firstName":"Anton S","initials":"AS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"All-Russia Research Institute for Agricultural Microbiology (ARRIAM), St. Petersburg, Pushkin, Russia, 196608."}]}},{"fullName":"Tikhonovich IA","lastName":"Tikhonovich","firstName":"Igor A","initials":"IA","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Genetics and Life Science, Sirius University of Science and Technology, Sochi, Russia, 354340."},{"affiliation":"Faculty of Biology, St. Petersburg State University, Saint-Petersburg, Russia."},{"affiliation":"All-Russia Research Institute for Agricultural Microbiology (ARRIAM), St. Petersburg, Pushkin, Russia, 196608."}]}},{"fullName":"Zhukov VA","lastName":"Zhukov","firstName":"Vladimir A","initials":"VA","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Genetics and Life Science, Sirius University of Science and Technology, Sochi, Russia, 354340."},{"affiliation":"All-Russia Research Institute for Agricultural Microbiology (ARRIAM), St. Petersburg, Pushkin, Russia, 196608."},{"affiliation":"N. I. Vavilov All-Russian Institute of Plant Genetic Resources (VIR), St. Petersburg, Russia, 190000."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0005-5967-5664"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"1","volume":"35","journalIssueId":4170112,"dateOfPublication":"2026 Apr","monthOfPublication":4,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Transgenic Res","title":"Transgenic research","essn":"1573-9368","issn":"0962-8819","nlmid":"9209120","isoabbreviation":"Transgenic Res"},"printPublicationDate":"2026-04-01"},"pubYear":"2026","pageInfo":"14","abstractText":"Pea (Pisum sativum L.) symbiosis with nodule bacteria supplying plants with additional nitrogen is a very specific plant-microbial interaction. Mutual recognition of the partners occurs through perception of bacterial signal molecules (Nod factors) by plant receptors, enabling bacterial entry via root hairs and formation of nitrogen-fixing nodules. The pea gene Sym2, described but not yet cloned, exists in different allelic forms defining the symbiotic specificity, and is therefore thought to encode a Nod factor receptor. The PsLykX gene is a strong candidate for the Sym2, since its alleles coincide with high or low symbiotic specificity; however, to date, no genetic evidence has been obtained for a role of PsLykX in symbiosis. Here, we knocked-out the PsLykX in European pea cultivar Caméor using Agrobacterium-mediated hairy root transformation and CRISPR-Cas9 editing. The roots with editing events confirmed by sequencing lost the ability to form nodules, providing direct functional evidence that PsLykX is essential, at least, for the symbiosis between pea cultivar Caméor and Rhizobium ruizarguesonis RCAM1026.","affiliation":"Center for Genetics and Life Science, Sirius University of Science and Technology, Sochi, Russia, 354340. zhuravlev.iy@talantiuspeh.ru.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Rhizobium","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Plants, Genetically Modified","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"GD","qualifierName":"growth & development"}]}},{"majorTopic_YN":"N","descriptorName":"Plant Roots","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"GD","qualifierName":"growth & development"},{"majorTopic_YN":"N","abbreviation":"MI","qualifierName":"microbiology"}]}},{"majorTopic_YN":"Y","descriptorName":"Plant Proteins","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Nitrogen Fixation","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Symbiosis","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Root Nodules, Pla