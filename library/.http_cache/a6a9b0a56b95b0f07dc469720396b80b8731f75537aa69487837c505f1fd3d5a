sseldorf, Germany."}]}},{"fullName":"Hensel G","lastName":"Hensel","firstName":"Götz","initials":"G","authorId":{"type":"ORCID","value":"0000-0002-5539-3097"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Centre for Plant Genome Engineering, Faculty of Mathematics and Natural Sciences, Heinrich Heine University Düsseldorf, Düsseldorf, Germany."},{"affiliation":"Cluster of Excellence in Plant Sciences (CEPLAS), Heinrich Heine University Düsseldorf, Düsseldorf, Germany."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-7136-0589"},{"type":"ORCID","value":"0000-0002-5539-3097"},{"type":"ORCID","value":"0009-0005-8643-1470"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"6","volume":"24","journalIssueId":4200424,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Plant Biotechnol J","title":"Plant biotechnology journal","essn":"1467-7652","issn":"1467-7644","nlmid":"101201889","isoabbreviation":"Plant Biotechnol J"},"printPublicationDate":"2026-06-01"},"pubYear":"2026","pageInfo":"3594-3596","abstractText":"Grain amaranth is a nutritionally rich, stress-tolerant C<sub>4</sub> dicot with considerable potential for climate-resilient agriculture; however, efficient and reproducible protocols for stable transformation, regeneration, and CRISPR/Cas9-mediated editing have not yet been established. CRISPR/Cas-based genome editing is a cornerstone technology for accelerating the development of climate-resilient, high-yielding crops. Its effective application depends on robust, stable transformation procedures and CRISPR/Cas systems optimised for the target species. The absence of such tools remains a critical constraint for the genetic improvement of many promising yet underexplored crops. In this study, we edited key genes of the betalain biosynthesis pathway in grain amaranth (Amaranthus hypochondriacus L.) using the CasCADE modular cloning system, thereby demonstrating the feasibility of targeted mutagenesis in an orphan crop. We observed successful edits in up to 49% of transformed calli, resulting in deletions or insertions in the target genes. Our CRISPR/Cas9-mediated editing paves the way for targeted molecular research and breeding of grain amaranth.","affiliation":"Centre for Plant Genome Engineering, Faculty of Mathematics and Natural Sciences, Heinrich Heine University Düsseldorf, Düsseldorf, Germany.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["brief-report","Journal Article"]},"grantsList":{"grant":[{"agency":"Deutsche Forschungsgemeinschaft","grantId":"EXC‐2048/1 project ID 390686111","orderIn":0},{"agency":"Deutsche Forschungsgemeinschaft","grantId":"EXC-2048/1 project ID 390686111","orderIn":0},{"agency":"Deutsche Forschungsgemeinschaft","grantId":"STE 2654/4","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Plants, Genetically Modified","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Amaranthus","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"Y","descriptorName":"Mutagenesis","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Transformation, Genetic"},{"majorTopic_YN":"Y","descriptorName":"CRISPR-Cas Systems","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Edible Grain","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Gene Editing","