.org/articles/PMC13750538?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["gen","refseq"]},"dateOfCompletion":"2026-11-10","dateOfCreation":"2026-11-10","dateOfRevision":"2026-11-12","electronicPublicationDate":"2026-11-10","firstPublicationDate":"2026-11-10","firstIndexDate":"2026-11-11","fullTextReceivedDate":"2026-11-11","hasEvaluations":"N"},{"id":"40801569","source":"MED","pmid":"40801569","pmcid":"PMC12346122","fullTextIdList":{"fullTextId":["PMC12346122"]},"doi":"10.3390/cells14151136","title":"Nanotechnology-Based Delivery of CRISPR/Cas9 for Cancer Treatment: A Comprehensive Review.","authorString":"Rauf MA, Rao A, Sivasoorian SS, Iyer AK.","authorList":{"author":[{"fullName":"Rauf MA","lastName":"Rauf","firstName":"Mohd Ahmar","initials":"MA","authorId":{"type":"ORCID","value":"0000-0001-5639-2208"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Internal Medicine, Heme/Oncology Unit, University of Michigan, Ann Arbor, MI 48109, USA."},{"affiliation":"Department of Pharmaceutical Sciences, Eugene Applebaum College of Pharmacy and Health Sciences, Wayne State University, Detroit, MI 48201, USA."}]}},{"fullName":"Rao A","lastName":"Rao","firstName":"Afifa","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Jamia Hamdard Medical College, Jamia Hamdard University, New Delhi 110062, India."}]}},{"fullName":"Sivasoorian SS","lastName":"Sivasoorian","firstName":"Siva Sankari","initials":"SS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pharmaceutical Sciences, Eugene Applebaum College of Pharmacy and Health Sciences, Wayne State University, Detroit, MI 48201, USA."}]}},{"fullName":"Iyer AK","lastName":"Iyer","firstName":"Arun K","initials":"AK","authorId":{"type":"ORCID","value":"0000-0002-4428-0222"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pharmaceutical Sciences, Eugene Applebaum College of Pharmacy and Health Sciences, Wayne State University, Detroit, MI 48201, USA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5639-2208"},{"type":"ORCID","value":"0000-0002-4428-0222"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"15","volume":"14","journalIssueId":3985992,"dateOfPublication":"2025 Jul","monthOfPublication":7,"yearOfPublication":2025,"journal":{"medlineAbbreviation":"Cells","title":"Cells","essn":"2073-4409","issn":"2073-4409","nlmid":"101600052","isoabbreviation":"Cells"},"printPublicationDate":"2025-07-01"},"pubYear":"2025","pageInfo":"1136","abstractText":"CRISPR/Cas9 (Clustered Regularly Interspaced Short Palindromic Repeats-associated protein 9)-mediated genome editing has emerged as a transformative tool in medicine, offering significant potential for cancer therapy because of its capacity to precisely target and alter the genetic modifications associated with the disease. However, a major challenge for its clinical translation is the safe and efficient in vivo delivery of CRISPR/Cas9 components to target cells. Nanotechnology is a promising solution to this problem. Nanocarriers, owing to their tunable physicochemical properties, can encapsulate and protect CRISPR/Cas9 components, enabling targeted delivery and enhanced cellular uptake. This review provides a comprehensive examination of the synergistic potential of CRISPR/Cas9 and nanotechnology in cancer therapy and explores their integrated therapeutic applications in gene editing and immunotherapy. A critical aspect of in vivo CRISPR/Cas9 application is to achieve effective localization at the tumor site while minimizing off-target effects. Nanocarriers can be engineered to overcome biological barriers, thereby augmenting tumor-specific delivery and facilitating intracellular uptake. Furthermore, their design allows for controlled release of the therapeutic payload, ensuring sustained efficacy and reduced systemic toxicity. The optimization of nanocarrier attributes, including size, shape, surface charge, and composition, is crucial for improving the cellular internalization, endosomal escape, and nuclear localization of CRISPR/Cas9. Moreover, surface functionalization with targeting ligands can enhance the specificity of cancer cells, leading to improved gene-editing accuracy. This review thoroughly discusses the challenges associated with in vivo CRISPR/Cas9 delivery and the innovative nanotechnological strategies employed to overcome them, highlighting their combined potential for advancing cancer treatment for clinical application.","affiliation":"Department of Internal Medicine, Heme/Oncology Unit, University of Michigan, Ann Arbor, MI 48109, USA.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"agency":"United States Department of Defense (DoD)/CDMRP","grantId":"W81XWH-18-1-0471","orderIn":0},{"agency":"Iyer lab","grantId":"W81XWH-18-1-0471","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Neoplasms","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"TH","qualifierName":"therapy"}]}},{"majorTopic_YN":"Y","descriptorName":"Gene Transfer Techniques"},{"majorTopic_YN":"Y","descriptorName":"Nanotechnology","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}},{"majorTopic_YN":"N","descriptorName":"Genetic Therapy","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}},{"majorTopic_YN":"Y","descriptorName":"CRISPR-Cas Systems","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Gene Editing","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}}]},"keywordList":{"keyword":["Nanotechnology","Gene Editing","Crispr/cas9"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/cells14151136"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12346122"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12346122?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":33,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["nct","doi"]},"dateOfCompletion":"2025-08-26","dateOfCreation":"2025-08-13","dateOfRevision":"2025-08-26","electronicPublicationDate":"2025-07-23","firstPublicationDate":"2025-07-23","firstIndexDate":"2025-08-21","fullTextReceivedDate":"2025-12-02","hasEvaluations":"N"},{"id":"41648761","source":"MED","pmid":"41648761","pmcid":"PMC12868297","fullTextIdList":{"fullTextId":["PMC12868297"]},"doi":"10.3389/fpubh.2025.1737251","title":"A narrative review of precision and ethical considerations in cardiovascular health: CRISPR-Cas9, telemedicine, and lifestyle interventions.","authorString":"Lu Z, Bukhari STH, Azeem M, Tariq N, Shabbir MAB.","authorList":{"author":[{"fullName":"Lu Z","lastName":"Lu","firstName":"Zhoumin","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Cardiovascular Medicine, Dazhou Dachuan District People's Hospital China (Dazhou Third People's Hospital), Dazhou, China."}]}},{"fullName":"Bukhari STH","lastName":"Bukhari","firstName":"Syeda Taqveem Hassan","initials":"STH","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Microbiology, University of Veterinary and Animal Sciences, Lahore, Pakistan."}]}},{"fullName":"Azeem M","lastName":"Azeem","firstName":"Muhammad","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Allied Health Sciences, The Superior University, Lahore, Pakistan."}]}},{"fullName":"Tariq N","lastName":"Tariq","firstName":"Nusrat","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"M. Islam Medical and Dental College, Gujranwala, Pakistan."}]}},{"fullName":"Shabbir MAB","lastName":"Shabbir","firstName":"Muhammad Abu Bakr","initials":"MAB","authorId":{"type":"ORCID","value":"0000-0002-2575-1674"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Microbiology, University of Veterinary and Animal Sciences, Lahore, Pakistan."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2575-1674"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"13","journalIssueId":3893151,"dateOfPublication":"2025 ","monthOfPublication":0,"yearOfPublication":2025,"journal":{"medlineAbbreviation":"Front Public Health","title":"Frontiers in public health","essn":"2296-2565","issn":"2296-2565","nlmid":"101616579","isoabbreviation":"Front Public Health"},"printPublicationDate":"2025-01-01"},"pubYear":"2025","pageInfo":"1737251","abstractText":"<h4>Background</h4>Cardiovascular diseases (CVDs) remain the leading cause of global morbidity and mortality, influenced by lifestyle, socioeconomic status, and genetic factors. Emerging innovations, including wearable health technologies, telemedicine, and CRISPR-Cas9 gene editing, provide new possibilities for rapid prevention and personalized management.<h4>Methods</h4>This narrative review collected evidence from Scopus, PubMed, and Google Scholar, using keywords such as cardiovascular (CV) prevention, lifestyle determinants, digital health, telemedicine, CRISPR-Cas9, and public health ethics. Eligible peer-reviewed studies, clinical guidelines, and policy documents were included to assess behavioral, technological, and genomic strategies for CVD care.<h4>Results</h4>Modifications in lifestyle, such as quitting smoking, regular physical activity, following a heart-healthy diet plan, and getting adequate sleep, can significantly reduce the risk of CVD. Additionally, telemedicine and wearable devices facilitate early detection, better self-management, and treatment adherence, especially in underserved communities. CRISPR-Cas9 holds a significant potential for correcting genetic variants related to lipid disorders and inherited cardiomyopathies, but its clinical translation remains in early stages. However, existing evidence is limited by heterogeneity in study design, brief follow-up, particularly for digital health and CRISPR applications. Additional challenges, such as health inequities, digital access, data privacy, and ethical oversight, further influence their real-world implementation.<h4>Conclusion</h4>Effective integration of behavioral, digital and genomic innovations requires policy frameworks that ensure equity, ethical governance, and long-term sustainability. Combining precision medicine with efforts to address social determinants of health will be crucial in reducing the global burden of CVD and shaping the future of CV care.","affiliation":"Department of Cardiovascular Medicine, Dazhou Dachuan District People's Hospital China (Dazhou Third People's Hospital), Dazhou, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Cardiovascular Diseases","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"PC","qualifierName":"prevention & control"},{"majorTopic_YN":"N","abbreviation":"TH","qualifierName":"therapy"}]}},{"majorTopic_YN":"Y","descriptorName":"Life Style"},{"majorTopic_YN":"Y","descriptorName":"Telemedicine","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ES","qualifierName":"ethics"}]}},{"majorTopic_YN":"Y","descriptorName":"CRISPR-Cas Systems"},{"majorTopic_YN":"Y","descriptorName":"Precision Medicine","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ES","qualifierName":"ethics"}]}},{"majorTopic_YN":"N","descriptorName":"Gene Editing","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ES","qualifierName":"ethics"}]}},{"majorTopic_YN":"N","descriptorName":"Digital Health"}]},"keywordList":{"keyword":["Risk factor","Public Health","behavioral change","Cvds","Precision Medicine","Crispr-cas9"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fpubh.2025.1737251"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12868297"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12868297?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPM