f, Arizona."},{"affiliation":"These authors contributed equally to this work."}]}},{"fullName":"Morales MM","lastName":"Morales","firstName":"Matthew M","initials":"MM","authorId":{"type":"ORCID","value":"0009-0004-3137-2429"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pathogen and Microbiome Institute, Northern Arizona University, Flagstaff, Arizona."},{"affiliation":"These authors contributed equally to this work."}]}},{"fullName":"Szewczyk E","lastName":"Szewczyk","firstName":"Edyta","initials":"E","authorId":{"type":"ORCID","value":"0000-0002-2054-5855"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Plant and Microbial Biology, University of California, Berkeley, Berkeley, California."}]}},{"fullName":"Homer CM","lastName":"Homer","firstName":"Christina M","initials":"CM","authorId":{"type":"ORCID","value":"0000-0003-4835-090X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Microbiology and Immunology, University of California, San Francisco, San Francisco, California."}]}},{"fullName":"Itogawa AN","lastName":"Itogawa","firstName":"Ashley N","initials":"AN","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pathogen and Microbiome Institute, Northern Arizona University, Flagstaff, Arizona."}]}},{"fullName":"Brem RB","lastName":"Brem","firstName":"Rachel B","initials":"RB","authorId":{"type":"ORCID","value":"0000-0002-8587-9434"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Plant and Microbial Biology, University of California, Berkeley, Berkeley, California."}]}},{"fullName":"Sil A","lastName":"Sil","firstName":"Anita","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-3987-7534"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Microbiology and Immunology, University of California, San Francisco, San Francisco, California."}]}},{"fullName":"Barker BM","lastName":"Barker","firstName":"Bridget M","initials":"BM","authorId":{"type":"ORCID","value":"0000-0002-3439-4517"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Pathogen and Microbiome Institute, Northern Arizona University, Flagstaff, Arizona."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2054-5855"},{"type":"ORCID","value":"0000-0002-2944-8015"},{"type":"ORCID","value":"0000-0002-3439-4517"},{"type":"ORCID","value":"0000-0002-3987-7534"},{"type":"ORCID","value":"0000-0002-8587-9434"},{"type":"ORCID","value":"0000-0003-4835-090X"},{"type":"ORCID","value":"0009-0004-3137-2429"}]},"journalInfo":{"issue":"9","volume":"6","journalIssueId":4250943,"dateOfPublication":"2026 Sep","monthOfPublication":9,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Curr Protoc","title":"Current protocols","essn":"2691-1299","issn":"2691-1299","nlmid":"101773894","isoabbreviation":"Curr Protoc"},"printPublicationDate":"2026-09-01"},"pubYear":"2026","pageInfo":"e70444","abstractText":"Coccidioides posadasii and C. immitis are human fungal pathogens endemic to the American Southwest. C. posadasii and C. immitis are the causative agents of coccidioidomycosis, or Valley fever. They are pathogens of growing concern, as reported cases of coccidioidomycosis have increased 20-fold in the last two decades. Despite their importance as pathogens, Coccidioides spp. are understudied, especially compared to other human fungal pathogens with similar infectious burdens. The reasons Coccidioides spp. are understudied are multifactorial, including requirement of high biocontainment, technical difficulties in lab-based culture growth, and a historic lack of genetic tools. Previous methods of genetic manipulation have been technically challenging, time consuming, and inefficient. Here, we present protocols for designing gene deletion constructs, generating protoplasts from both genetically engineered biosafety level 2 (BSL2) and wildtype biosafety level 3 (BSL3) strains, and performing transformations with CRISPR/Cas9. The protoplasting protocol described here uses a cell wall digestion enzyme employed in the wine-making industry and results in high-quality protoplasts that have the potential to be used for applications beyond transformations. We also present a high-efficiency transformation method using CRISPR/Cas9. The protocols described here will allow for genetic manipulation of Coccidioides, using both BSL2 and BSL3 strains. This resource can be applied to expand research done in Coccidioides spp., build molecular tools, and expand overall knowledge of these important pathogens. © 2026 The Author(s). Current Protocols published by Wiley Periodicals LLC. Basic Protocol 1: Construction of gene deletion construct Alternate Protocol 1: Construction of gene deletion construct Basic Protocol 2: Creation of protoplasts in BSL3 Alternate Protocol 2: Creation of protoplasts in BSL2 Basic Protocol 3: CRISPR/Cas9 transformation in BSL3 Alternate Protocol 3: CRISPR/Cas9 transformation in BSL2 Support Protocol: Passaging of mutants and PCR confirmation.","affiliation":"Pathogen and Microbiome Institute, Northern Arizona University, Flagstaff, Arizona.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["other","Journal Article"]},"grantsList":{"grant":[{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"U10AI166058","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"R21 AI193607","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"1U19AI166798","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"R21AI193607","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"U19 AI166058","orderIn":0},{"agency":"NIAID NIH HHS","acronym":"AI","grantId":"U19 AI166798","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"Y","descriptorName":"Protoplasts","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ME","qualifierName":"metabolism"}]}},{"majorTopic_YN":"Y","descriptorName":"Coccidioides","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"Coccidioidomycosis","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MI","qualifierName":"microbiology"}]}},{"majorTopic_YN":"N","descriptorName":"Gene Deletion"},{"majorTopic_YN":"Y","descriptorName":"Transformation, Genetic"},{"majorTopic_YN":"Y","descriptorName":"CRISPR-Cas Systems","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}}]},"keywordList":{"keyword":["Coccidioides","Fungal Genetics","Crispr","Protoplasting","Homology‐directed Repair"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1002/cpz1.70444"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13584938"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13584938?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"N","hasData":"Y","license":"cc by-nc","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-09-17","dateOfCreation":"2026-09-17","dateOfRevision":"2026-09-23","firstPublicationDate":"2026-09-01","firstIndexDate":"2026-09-18","fullTextReceivedDate":"2026-09-18","hasEvaluations":"N"},{"id":"42886411","source":"MED","pmid":"42886411","doi":"10.1007/s11033-026-12916-2","title":"Precision gene editing in infant neuroblastoma: a review of nanoparticle: enabled CRISPR/Cas9 therapies.","authorString":"Kaknale S, Ranjan A, Enoch IVMV, Vyas A, Manikantan V.","authorList":{"author":[{"fullName":"Kaknale S","lastName":"Kaknale","firstName":"Samruddhi","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pharmacology, Symbiosis Medical College for Women (SMCW), Symbiosis University Hospital and Research Centre (SUHRC), Symbiosis International (Deemed University), Lavale, Pune, 412115, India."}]}},{"fullName":"Ranjan A","lastName":"Ranjan","firstName":"Ayush","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Symbiosis School of Biological Sciences, Symbiosis International (Deemed University), Lavale, Pune, 412115, India."}]}},{"fullName":"Enoch IVMV","lastName":"Enoch","firstName":"Israel V M V","initials":"IVMV","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Physical Sciences, Karunya Institute of Technology and Sciences (Deemed University), Coimbatore, 641114, Tamil Nadu, India."}]}},{"fullName":"Vyas A","lastName":"Vyas","firstName":"Abhijit","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-8264-9414"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Manipal Institute of Technology Bengaluru, Manipal Academy of Higher Education, Manipal, 576104, Karnataka, India."}]}},{"fullName":"Manikantan V","lastName":"Manikantan","firstName":"Varnitha","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pharmacology, Symbiosis Medical College for Women (SMCW), Symbiosis University Hospital and Research Centre (SUHRC), Symbiosis International (Deemed University), Lavale, Pune, 412115, India. varnithamcbe@gmail.com."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-8264-9414"}]},"journalInfo":{"issue":"1","volume":"53","journalIssueId":4275659,"dateOfPublication":"2026 Oct","monthOfPublication":10,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Mol Biol Rep","title":"Molecular biology reports","essn":"1573-4978","issn":"0301-4851","nlmid":"0403234","isoabbreviation":"Mol Biol Rep"},"printPublicationDate":"2026-10-01"},"pubYear":"2026","pageInfo":"1725","abstractText":"Infant neuroblastoma (NB), defined by diagnosis during the first year of life, represents a clinically heterogeneous disease spectrum ranging from localized tumours with favourable outcomes and a capacity for spontaneous regression, to high-risk metastatic disease requiring intensive multimodal therapy. In infants, treatment intensity is determined by disease stage, tumor biology, MYCN status, risk classification, symptoms, response to therapy, and metastatic involvement, particularly relevant to high-risk disease, consequently the potential toxicity of intensive treatment is specific to high-risk disease, as compared to favorable risk tumors which can be managed with surgery, reduced frequency techniques, or observations. Important determinations of neuroblastoma biology and prognosis are genetic alterations involving MYCN and ALK, but the predominately investigated field with therapeutic feasibility of targeting these changes with CRISPR/Cas9 is in preclinical neuroblastoma models rather than in infants. An investigational hypothesis is accordingly considered by their potential relevance to infant neuroblastoma rather than an established clinical application. The safe and efficient in vivo delivery of CRISPR/Cas9 components remains a major challenge, owing to cargo size, immunogenicity, and degradation, particularly within the delicate physiological environment of infants. This review emphasises the need for advanced delivery systems, focusing on the potential of nanoparticle-mediated approaches. Emerging preclinical findings support the feasibility of nanoparticle-mediated CRISPR/Cas9 delivery, although direct evidence in infant neuroblastoma remains limited. Importantly, the evidence for nanoparticle-mediated CRISPR/Cas9 therapy remains largely preclinical. Studies performed in general neuroblastoma models, non-cancer models, or adult cancers should not be interpreted as direct evidence of efficacy in infant neuroblastoma.","affiliation":"Department of Pharmacology, Symbiosis Medical College for Women (SMCW), Symbiosis University Hospital and Research Centre (SUHRC), Symbiosis International (Deemed University), Lavale, Pune, 412115, India.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Animals"},{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Neuroblastoma","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"TH","qualifierName":"therapy"}]}},{"majorTopic_YN":"N","descriptorName":"Infant"},{"majorTopic_YN":"Y","descriptorName":"Nanoparticles","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"CH","qualifierName":"chemistry"}]}},{"majorTopic_YN":"Y","descriptorName":"Genetic Therapy","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}},{"majorTopic_YN":"Y","descriptorName":"CRISPR-Cas Systems","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"N","descriptorName":"N-Myc Proto-Oncogene Protein","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}},{"majorTopic_YN":"Y","descriptorName":"Gene Editing","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"MT","qualifierName":"methods"}]}},{"majorTopic_YN":"N","descriptorName":"Anaplastic Lymphoma Kinase","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"}]}}]},"keywordList":{"keyword":["Gene therapy","Nanoparticles","alk","Drug Delivery","Paediatric Oncology","Mycn","Crispr/cas9","Infant Neuroblastoma"]},"chemicalList":{"chemical":[{"name":"MYCN protein, human","registryNumber":"0"},{"name":"anaplastic lymphoma kinase","registryNumber":"EC 2.7.10.1"},{"name":"N-Myc Proto-Oncogene Protein","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1007/s11033-026-12916-2"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":0,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"N","hasData":"N","license":"cc by-nc-nd","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-10-16","dateOfCreation":"2026-10-16","dateOfRevision":"2026-10-19","electronicPublicationDate":"2026-10-16","firstPublicationDate":"2026-10-16","firstIndexDate":"2026-10-19","hasEvaluations":"N"},{"id":"42771314","source":"MED","pmid":"42771314","doi":"10.1007/978-1-0716-5547-4_11","title":"CRISPR/Cas9 Delivery Using Extracellular Vesicles.","authorString":"Pečan P, Manček-Keber M.","authorList":{"author":[{"fullName":"Pečan P","lastName":"Pečan","firstName":"Peter","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Synthetic Biology and Immunology, National Institute of Chemistry, Hajdrihova 19, Ljubljana, Slovenia."},{"affiliation":"Graduate School of Biomedicine, University of Ljubljana, Ljubljana, Slovenia."}]}},{"fullName":"Manček-Keber M","lastName":"Manček-Keber","firstName":"Mateja","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Synthetic Biology and Immunology, National Institute of Chemistry, Hajdrihova 19, Ljubljana, Slovenia. mateja.mancek@ki.si."}]}}]},"journalInfo":{"volume":"3075","journalIssueId":4269687,"dateOfPublication":"2027 ","monthOfPublication":0,"yearOfPublication":2027,"journal":{"medlineAbbreviation":"Methods Mol Biol","title":"Methods in molecular biology (Clifton, N.J.)","essn":"1940-6029","issn":"1064-3745","nlmid":"9214969","isoabbreviation":"Methods Mol Biol"},"printPublicationDate":"2027-01-01"},"pubYear":"2027","pageInfo":"219-235","abstractText":"Extracellular vesicles (EVs), particles released from cells, have the potential to become an important in vivo delivery vehicle for CRISPR machinery. Unlike viral vectors such as Adeno-associated virus (AAV), EVs reduce risks associated with immunogenicity, long-term expression, and potential off-target effects. EVs can efficiently deliver CRISPR/Cas9 ribonucleoprotein (RNP) complexes, which provide transient, ready-to-function editing machinery with reduced off-target risk compared with plasmid DNA or mRNA delivery. RNP loading into EVs can occur without specific targeting signals, although strategies such as membrane anchoring, inducible dimerization systems, or fusion with EV-associated proteins can enhance cargo enrichment. EVs are typically produced by transfecting producer cells with plasmids encoding Cas9 and sgRNA, followed by vesicle release into culture media. Purification requires removal of cellular debris and enrichment of vesicles using methods such as ultracentrifugation, ultrafiltration, chromatography, or precipitation. As no single gold-standard purification approach exists, method selection should balance yield and purity, and characterization using vesicle markers and size distribution profiling is recommended.","affiliation":"Department of Synthetic Biology and Immunology, National Institute of Chemistry, Hajdrihova 19, Ljubljana, Slovenia.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","d