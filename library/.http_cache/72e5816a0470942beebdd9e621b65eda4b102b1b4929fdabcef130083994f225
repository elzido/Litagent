pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":1,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"N","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-09-16","dateOfCreation":"2026-09-16","dateOfRevision":"2026-09-25","firstPublicationDate":"2026-09-01","firstIndexDate":"2026-09-17","fullTextReceivedDate":"2026-09-17","hasEvaluations":"N"},{"id":"43017624","source":"MED","pmid":"43017624","doi":"10.36416/1806-3756/e20260119","title":"Prevalence and factors associated with the development of asthma in a cohort of children who were preterm infants and received passive immunization with palivizumab.","authorString":"Manini MB, da Silva NC, Cruz GDAG, Morcillo AM, Ribeiro JD, Toro AADC.","authorList":{"author":[{"fullName":"Manini MB","lastName":"Manini","firstName":"Mariana Bueno","initials":"MB","authorId":{"type":"ORCID","value":"0000-0002-9938-7246"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":". Programa de Pós-Graduação em Saúde da Criança e do Adolescente, Faculdade de Ciências Médicas, Universidade Estadual de Campinas - UNICAMP - Campinas (SP) Brasil."}]}},{"fullName":"da Silva NC","lastName":"da Silva","firstName":"Natali Caroline","initials":"NC","authorId":{"type":"ORCID","value":"0000-0002-5799-3555"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":". Programa de Pós-Graduação em Saúde da Criança e do Adolescente, Faculdade de Ciências Médicas, Universidade Estadual de Campinas - UNICAMP - Campinas (SP) Brasil."},{"affiliation":". Centro de Investigação em Pediatria, Faculdade de Ciências Médicas, Universidade Estadual de Campinas - UNICAMP - Campinas (SP) Brasil."}]}},{"fullName":"Cruz GDAG","lastName":"Cruz","firstName":"Gabriela do Amaral Gurgel","initials":"GDAG","authorId":{"type":"ORCID","value":"0009-0001-7556-2513"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":". Faculdade de Medicina, Pontifícia Universidade Católica de Campinas - PUCCAMP - Campinas (SP) Brasil."}]}},{"fullName":"Morcillo AM","lastName":"Morcillo","firstName":"André Moreno","initials":"AM","authorId":{"type":"ORCID","value":"0000-0002-2088-972X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":". Departamento de Pediatria, Faculdade de Ciências Médicas, Universidade Estadual de Campinas - UNICAMP - Campinas (SP) Brasil."}]}},{"fullName":"Ribeiro JD","lastName":"Ribeiro","firstName":"José Dirceu","initials":"JD","authorId":{"type":"ORCID","value":"0000-0002-3387-5642"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":". Centro de Investigação em Pediatria, Faculdade de Ciências Médicas, Universidade Estadual de Campinas - UNICAMP - Campinas (SP) Brasil."},{"affiliation":". Departamento de Pediatria, Faculdade de Ciências Médicas, Universidade Estadual de Campinas - UNICAMP - Campinas (SP) Brasil."}]}},{"fullName":"Toro AADC","lastName":"Toro","firstName":"Adyléia Aparecida Dalbo Contrera","initials":"AADC","authorId":{"type":"ORCID","value":"0000-0001-5777-1146"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":". Centro de Investigação em Pediatria, Faculdade de Ciências Médicas, Universidade Estadual de Campinas - UNICAMP - Campinas (SP) Brasil."},{"affiliation":". Departamento de Pediatria, Faculdade de Ciências Médicas, Universidade Estadual de Campinas - UNICAMP - Campinas (SP) Brasil."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5777-1146"},{"type":"ORCID","value":"0000-0002-2088-972X"},{"type":"ORCID","value":"0000-0002-3387-5642"},{"type":"ORCID","value":"0000-0002-5799-3555"},{"type":"ORCID","value":"0000-0002-9938-7246"},{"type":"ORCID","value":"0009-0001-7556-2513"}]},"journalInfo":{"issue":"5","volume":"52","journalIssueId":4314685,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"Respir Res Clin Pract","title":"Respiratory research & clinical practice","essn":"3086-3910","issn":"3086-3910","nlmid":"9919269228506676","isoabbreviation":"Respir Res Clin Pract"},"printPublicationDate":"2026-01-01"},"pubYear":"2026","pageInfo":"e20260119","abstractText":"<h4>Objective</h4>To assess the prevalence of asthma in a cohort of preterm infants, comparing those who received prophylaxis with palivizumab, a monoclonal antibody against respiratory syncytial virus (RSV), with those who did not. That is relevant because RSV infection has been linked to recurrent wheezing and asthma in childhood, but a causal relationship remains unclear.<h4>Methods</h4>This was a prospective cohort study involving children who were preterm infants without congenital heart disease, exposed or not to palivizumab. Parents or legal guardians answered a telephone questionnaire adapted from the International Study of Asthma and Allergies in Childhood, which covers respiratory symptoms, allergy history, and potential risk factors.<h4>Results</h4>Among 292 eligible children, 217 were included (149 in the palivizumab group and 68 in the control group). Of those 217 infants, 25.3% (95% CI:19.9-31.5%) had asthma: 24.2% (95% CI: 17.8-31.5%) in the palivizumab group and 27.9% (95% CI: 18.3-39.5%) in the control group, with no significant difference (p = 0.553). In the bivariate analysis, asthma was significantly associated with a family history of atopy (p < 0.001), parental asthma (p = 0.006), allergic rhinitis in the child (p < 0.001), and atopic dermatitis in the child (p = 0.022). In the multivariate analysis, asthma remained associated with a family history of atopy (adjusted OR = 4.16; 95% CI: 1.77-9.79), allergic rhinitis in the child (adjusted OR = 5.10; 95% CI: 2.59-10.02), and parental asthma (adjusted OR = 2.45; 95% CI: 1.19-5.04).<h4>Conclusions</h4>Palivizumab does not seem to protect against asthma development in preterm infants without congenital heart disease. A family history of atopy, parental asthma, and allergic rhinitis in the child seem to be the primary determinants of asthma risk in such infants.","affiliation":". Programa de Pós-Graduação em Saúde da Criança e do Adolescente, Faculdade de Ciências Médicas, Universidade Estadual de Campinas - UNICAMP - Campinas (SP) Brasil.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Respiratory Syncytial Virus Infections","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"EP","qualifierName":"epidemiology"},{"majorTopic_YN":"N","abbreviation":"PC","qualifierName":"prevention & control"}]}},{"majorTopic_YN":"Y","descriptorName":"Asthma","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"DI","qualifierName":"diagnosis"},{"majorTopic_YN":"N","abbreviation":"EP","qualifierName":"epidemiology"},{"majorTopic_YN":"N","abbreviation":"PC","qualifierName":"prevention & control"}]}},{"majorTopic_YN":"Y","descriptorName":"Antiviral Agents","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"AD","qualifierName":"administration & dosage"},{"majorTopic_YN":"N","abbreviation":"TU","qualifierName":"therapeutic use"}]}},{"majorTopic_YN":"N","descriptorName":"Prevalence"},{"majorTopic_YN":"N","descriptorName":"Risk Factors"},{"majorTopic_YN":"N","descriptorName":"Cohort Studies"},{"majorTopic_YN":"N","descriptorName":"Prospective Studies"},{"majorTopic_YN":"N","descriptorName":"Infant"},{"majorTopic_YN":"N","descriptorName":"Infant, Newborn"},{"majorTopic_YN":"Y","descriptorName":"Infant, Premature"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"},{"majorTopic_YN":"Y","descriptorName":"Palivizumab","meshQualifierList":{"meshQualifier":[{"majorTopic